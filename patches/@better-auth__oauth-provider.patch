+// patch(uploads): an AS that advertises its token endpoint on a second origin
+// (RFC 8414 metadata may place endpoints off the issuer origin) receives
+// assertions whose `aud` is that advertised URL. Accept the same endpoint path
+// on each operator-configured `clientAssertionAudienceOrigins` entry, in
+// addition to `${baseURL}<endpoint>` and the issuer. Exact origin + path only.
+function clientAssertionAliasAudiences(endpointAudience, aliasOrigins) {
+	if (!Array.isArray(aliasOrigins) || aliasOrigins.length === 0) return [];
+	let endpoint;
+	try {
+		endpoint = new URL(endpointAudience);
+	} catch {
+		return [];
+	}
+	const audiences = [];
+	for (const aliasOrigin of aliasOrigins) {
+		if (typeof aliasOrigin !== "string") continue;
+		let origin;
+		try {
+			origin = new URL(aliasOrigin).origin;
+		} catch {
+			continue;
+		}
+		if (origin === "null") continue;
+		audiences.push(`${origin}${endpoint.pathname}`);
+	}
+	return audiences;
+}
