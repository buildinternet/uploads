{
  "name": "@uploads/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @buildinternet/uploads run build && pnpm run build:ui",
    "dev": "wrangler dev",
    "predeploy": "pnpm --filter @buildinternet/uploads run build && pnpm run build:ui",
    "deploy": "node --env-file-if-exists=../../.env node_modules/wrangler/bin/wrangler.js deploy",
    "bundle:check": "wrangler deploy --dry-run --outdir .wrangler/bundle-check",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "pretest": "pnpm --filter @buildinternet/uploads run build && pnpm run build:ui",
    "test": "vitest run",
    "build:ui": "pnpm --filter @uploads/ui build && node ui/build.mjs",
    "pretypecheck": "pnpm run build:ui",
    "prebundle:check": "pnpm run build:ui"
  },
  "dependencies": {
    "@buildinternet/uploads": "workspace:^",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@uploads/api": "workspace:^",
    "@uploads/errors": "workspace:^",
    "@uploads/observability": "workspace:^",
    "@uploads/storage": "workspace:^",
    "@uploads/ui": "workspace:*",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
