---
/**
 * Client-side routing for multi-page shells (account, admin, docs).
 *
 * We use Astro’s ClientRouter to hold the current view while the next route
 * HTML is fetched, then swap — which removes the blank-page flicker of full
 * reloads. Animations are intentionally off (`fallback="swap"` here; layouts
 * also set `transition:animate="none"` on `<html>`).
 *
 * While the next page is fetched, the clicked sidebar tab is marked current
 * and a thin bar shows at the top, so a click is acknowledged before the
 * server answers. The swap replaces both with the new page's own state.
 *
 * Layout and page scripts that attach listeners or fill dynamic UI must re-run
 * on `astro:page-load` (bundled modules only execute once per session).
 */
import { ClientRouter } from "astro:transitions";
---

<ClientRouter fallback="swap" />

<script>
  document.addEventListener("astro:before-preparation", (event) => {
    // The swap copies the new page's <html> attributes over, which clears this.
    document.documentElement.dataset.navigating = "";

    const to = event.to;
    if (to.origin !== location.origin || to.pathname === location.pathname) return;
    const links = document.querySelectorAll<HTMLAnchorElement>("#shell-sidebar a[href]");
    const target = [...links].find((a) => new URL(a.href).pathname === to.pathname);
    if (!target) return;
    for (const a of links) {
      if (a.getAttribute("aria-current") !== "page") continue;
      a.removeAttribute("aria-current");
      a.removeAttribute("data-active");
    }
    target.setAttribute("aria-current", "page");
    target.setAttribute("data-active", "");
  });
</script>

<style is:global>
  @keyframes nav-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(0.9);
    }
  }
  /* Delayed so fast navigations never flash it. */
  html[data-navigating] body::before {
    content: "";
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    pointer-events: none;
    animation: nav-progress 8s cubic-bezier(0.1, 0.7, 0.2, 1) 120ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-navigating] body::before {
      animation: none;
      transform: scaleX(0.6);
    }
  }
</style>
