---
/**
 * Content-report form for public asset pages, rendered inside a <dialog> the
 * page opens (file page ⋯ menu). Cancel and a finished report close it.
 * Posts to POST /v1/abuse on the API origin.
 */
interface Props {
  /**
   * Absolute origin, or the same-origin "/api" prefix (#731 phase D) — either
   * way a bare string prefix, never fed through `new URL(path, apiOrigin)`
   * (that constructor requires an absolute base and would throw on "/api").
   */
  apiOrigin: string;
  pageUrl: string;
  workspace: string;
  objectKey: string;
}

const { apiOrigin, pageUrl, workspace, objectKey } = Astro.props;

const REASONS = [
  { value: "abuse", label: "Abuse" },
  { value: "copyright", label: "Copyright" },
  { value: "spam", label: "Spam" },
  { value: "privacy", label: "Privacy" },
  { value: "other", label: "Other" },
] as const;
---

<div class="report" data-report-abuse>
  <form class="report-form" data-report-form method="dialog">
    <h2 class="report-title">Report a problem</h2>
    <p class="report-lead">Flag this file for review. We read every report.</p>
    <label class="field">
      <span class="field-label">Reason</span>
      <select name="reason">
        {
          REASONS.map((r) =>
            r.value === "abuse" ? (
              <option value={r.value} selected>
                {r.label}
              </option>
            ) : (
              <option value={r.value}>{r.label}</option>
            ),
          )
        }
      </select>
    </label>
    <label class="field">
      <span class="field-label">Details <em>(required for Other)</em></span>
      <textarea name="message" rows="3" maxlength="2000" placeholder="What should we know?"
      ></textarea>
    </label>
    <label class="field">
      <span class="field-label">Contact <em>(optional)</em></span>
      <input
        type="text"
        name="contact"
        maxlength="200"
        placeholder="email or handle"
        autocomplete="email"
      />
    </label>
    <div class="report-actions">
      <button type="submit" class="report-submit">Submit report</button>
      <button type="button" class="report-cancel" data-report-cancel>Cancel</button>
    </div>
    <p class="report-status" data-report-status role="status" aria-live="polite" hidden></p>
  </form>
  <p class="report-done" data-report-done hidden>Thanks — we received your report.</p>
</div>

<script define:vars={{ apiOrigin, pageUrl, workspace, objectKey }}>
  (function () {
    const root = document.querySelector("[data-report-abuse]");
    if (!(root instanceof HTMLElement)) return;

    const dialog = root.closest("dialog");
    const form = root.querySelector("[data-report-form]");
    const cancel = root.querySelector("[data-report-cancel]");
    const status = root.querySelector("[data-report-status]");
    const done = root.querySelector("[data-report-done]");
    if (
      !(form instanceof HTMLFormElement) ||
      !(status instanceof HTMLElement) ||
      !(done instanceof HTMLElement)
    ) {
      return;
    }

    const close = () => {
      status.hidden = true;
      status.textContent = "";
      dialog?.close();
    };

    cancel?.addEventListener("click", close);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const reason = String(data.get("reason") || "abuse");
      const message = String(data.get("message") || "").trim();
      const contact = String(data.get("contact") || "").trim();
      const submitBtn = form.querySelector('button[type="submit"]');

      if (reason === "other" && message.length < 5) {
        status.hidden = false;
        status.dataset.tone = "error";
        status.textContent = "Please add a short description for Other.";
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
      status.hidden = false;
      status.dataset.tone = "";
      status.textContent = "Sending…";

      try {
        const res = await fetch(apiOrigin.replace(/\/$/, "") + "/v1/abuse", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({
            pageUrl,
            workspace,
            key: objectKey,
            reason,
            message: message || undefined,
            contact: contact || undefined,
            surface: "web",
          }),
        });
        if (!res.ok) {
          status.dataset.tone = "error";
          status.textContent =
            res.status === 429
              ? "Too many reports from this network. Try again in a minute."
              : "Could not send report. Try again, or email abuse@uploads.sh.";
          if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
          return;
        }
        form.hidden = true;
        status.hidden = true;
        done.hidden = false;
      } catch {
        status.dataset.tone = "error";
        status.textContent = "Network error. Email abuse@uploads.sh if this keeps happening.";
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
      }
    });
  })();
</script>

<style>
  .report {
    min-width: 0;
  }
  .report-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .report-title {
    margin: 0;
    color: var(--fg);
    font: 600 var(--text-ui) var(--sans);
  }
  /* `display: flex` above would override the HTML `hidden` attribute's
     UA `display: none`. */
  .report-form[hidden],
  .report-done[hidden],
  .report-status[hidden] {
    display: none;
  }
  .report-lead {
    margin: 0;
    color: var(--muted);
    font: var(--text-micro)/1.45 var(--sans);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }
  .field-label {
    color: var(--muted);
    font: var(--text-micro) var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .field-label em {
    font-style: normal;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.85;
  }
  .field select,
  .field textarea,
  .field input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--panel);
    color: var(--body);
    font: var(--text-micro)/1.45 var(--sans);
  }
  .field textarea {
    resize: vertical;
  }
  .field select:focus,
  .field textarea:focus,
  .field input:focus {
    border-color: var(--accent);
    outline: none;
  }
  .report-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .report-submit,
  .report-cancel {
    appearance: none;
    border-radius: var(--radius-md);
    font: var(--text-micro) var(--sans);
    cursor: pointer;
    padding: 8px 12px;
  }
  .report-submit {
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--fg);
  }
  .report-submit:hover,
  .report-submit:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    outline: none;
  }
  .report-submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .report-cancel {
    border: 0;
    background: none;
    color: var(--muted);
  }
  .report-cancel:hover,
  .report-cancel:focus-visible {
    color: var(--fg);
    outline: none;
  }
  .report-status,
  .report-done {
    margin: 0;
    font: var(--text-micro)/1.4 var(--sans);
    color: var(--muted);
  }
  .report-status[data-tone="error"] {
    color: #e07070;
  }
</style>
