---
/** Shared metadata hierarchy for standalone files, gallery items and live-link items. */
import { AI_CHIP_FIELDS, splitFileDetailMeta } from "../lib/ai-labels";
import { formatBytes, formatFileDate, sameUtcDay, shouldShowModified } from "../lib/public-file";
interface Props {
  metadata?: Record<string, string>;
  size?: number | null;
  uploaded?: string | null;
  modified?: string | null;
}
const { metadata, size = null, uploaded = null, modified = null } = Astro.props;
const detailMeta = splitFileDetailMeta(metadata);
const metadataEntries = [...detailMeta.primary, ...detailMeta.other];
const aiLabels = detailMeta.ai;
const aiChips = aiLabels
  ? AI_CHIP_FIELDS.flatMap((field) => {
      const value = aiLabels[field];
      return value ? [{ field, value }] : [];
    })
  : [];
const uploadedIso = uploaded ?? null;
const modifiedIso = modified ?? null;
const showModified = shouldShowModified(uploadedIso, modifiedIso);
const withTime = Boolean(
  showModified && uploadedIso && modifiedIso && sameUtcDay(uploadedIso, modifiedIso),
);
const uploadedLabel = uploadedIso ? formatFileDate(uploadedIso, { withTime }) : null;
const modifiedLabel =
  showModified && modifiedIso ? formatFileDate(modifiedIso, { withTime }) : null;
// Rail footnote (demoted from a Size/Uploaded/Modified dl — issue: right-rail hierarchy pass):
// one muted line beneath the actions instead of a data table.
const footnoteParts = [
  size != null ? formatBytes(size) : null,
  uploadedLabel ? `Uploaded ${uploadedLabel}` : null,
  modifiedLabel ? `Modified ${modifiedLabel}` : null,
].filter((part): part is string => Boolean(part));
const footnoteLine = footnoteParts.join(" · ");
---

{
  metadataEntries.length > 0 && (
    <div>
      <div class="rail-head">
        <span class="rail-label">Details</span>
        <span class="rail-rule" aria-hidden="true" />
      </div>
      <dl class="meta">
        {metadataEntries.map((entry) => (
          <>
            <dt>{entry.key}</dt>
            <dd>{entry.value}</dd>
          </>
        ))}
      </dl>
    </div>
  )
}
{
  aiLabels && (
    <div class="ai-labels">
      <div class="rail-head">
        <span class="rail-label">AI labels</span>
        <span class="ai-labels-exp">experimental</span>
        <span class="rail-rule" aria-hidden="true" />
      </div>
      {(aiChips.length > 0 || aiLabels.tags.length > 0) && (
        <div class="ai-chips">
          {aiChips.map((chip) => (
            <span class="ai-chip">
              <span class="ai-chip-key">{chip.field}</span>
              <span class="ai-chip-value">{chip.value}</span>
            </span>
          ))}
          {aiLabels.tags.map((tag) => (
            <span class="ai-chip">
              <span class="ai-chip-value">{tag}</span>
            </span>
          ))}
        </div>
      )}
      {aiLabels.summary && <p class="ai-summary">{aiLabels.summary}</p>}
    </div>
  )
}
{footnoteLine && <p class="footnote">{footnoteLine}</p>}

<style>
  .rail-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
  }
  .rail-label {
    color: var(--muted);
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .rail-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  dl.meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
    font: var(--text-micro) var(--mono);
  }
  dl.meta dt {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-micro);
  }
  dl.meta dd {
    margin: 0;
    color: var(--body);
    overflow-wrap: anywhere;
  }
  .ai-labels {
    display: grid;
    gap: 8px;
  }
  .ai-labels-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .ai-labels-exp {
    color: var(--muted);
    font: var(--text-micro) var(--sans);
    opacity: 0.7;
  }
  .ai-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: 100%;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--panel);
    color: var(--fg);
    font: var(--text-micro) var(--mono);
  }
  .ai-chip-key {
    color: var(--muted);
  }
  .ai-chip-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ai-summary {
    margin: 0;
    color: var(--muted);
    font: var(--text-micro) / 1.5 var(--sans);
  }
  /* Subordinate to everything above — margin-top:auto sinks it (and ReportAbuse, right
         after it in flow) to the bottom of the rail on tall pages, no-op on short ones. */
  .footnote {
    margin: auto 0 0;
    color: var(--muted);
    font: var(--text-micro)/1.5 var(--sans);
  }
</style>
