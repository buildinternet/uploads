---
/**
 * One settings row: label and description on the left, the control (default
 * slot) on the right. Styles live in account-content.css (`.setting-row`).
 * `chipId` adds an empty slot beside the label for a source badge; the
 * status span shows "Saving…" / "Saved" via `setRowStatus`.
 */
interface Props {
  label: string;
  description: string;
  id?: string;
  chipId?: string;
  /** Docs page for this setting, linked after the description. */
  docsHref?: string;
}

const { label, description, id, chipId, docsHref } = Astro.props;
---

<div class="setting-row" id={id}>
  <div class="min-w-0">
    <div class="setting-row__head">
      <span class="setting-row__label">{label}</span>
      {chipId && <span id={chipId} />}
    </div>
    <p class="setting-row__desc">
      {description}
      {docsHref && <a href={docsHref}>How it works</a>}
    </p>
  </div>
  <div class="setting-row__control">
    <span class="setting-row__status" role="status" aria-live="polite"></span>
    <slot />
  </div>
</div>
