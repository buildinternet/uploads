---
/**
 * Shared Copy / Copy as / Download controls for public file and gallery-item
 * pages — one place for markup, styles, and the delegated copy handlers.
 *
 * Default slot: optional links beside Download (e.g. "Open original"). Slotted
 * `<a class="original">` is styled via `:global` so parent-scoped markup still matches.
 */
import type { EmbedFormatOption } from "../lib/embed-formats";

interface Props {
  formats: EmbedFormatOption[];
  downloadUrl?: string | null;
}

const { formats, downloadUrl = null } = Astro.props;
const defaultFormat = formats[0];
const defaultCopyValue = defaultFormat?.value ?? "";
const defaultCopyLabel = defaultFormat?.label ?? "";
const show = Boolean(downloadUrl) || formats.length > 0;
---

{
  show && (
    <div class="actions" data-public-copy-controls>
      <div class="links">
        <slot />
        {downloadUrl && (
          <a class="original download" href={downloadUrl} rel="noopener noreferrer">
            Download
          </a>
        )}
      </div>
      {formats.length > 0 && (
        <div class="copy">
          {/* Format picker + one explicit Copy button; the value below is a
             quiet one-line preview, not a click target. */}
          <div class="copyrow">
            <select id="copy-format" class="ul-select" aria-label="Copy as format">
              {formats.map((format) => (
                <option value={format.id} data-copy-value={format.value}>
                  {format.label}
                </option>
              ))}
            </select>
            <button
              type="button"
              id="copy-format-btn"
              class="copy-btn"
              data-copy={defaultCopyValue}
              title={`Copy ${defaultCopyLabel}`}
            >
              Copy
            </button>
          </div>
          <code id="copy-snippet-value" class="preview" title={defaultCopyValue}>
            {defaultCopyValue}
          </code>
          <span id="copy-status" class="sr-only" aria-live="polite" />
        </div>
      )}
    </div>
  )
}

<script>
  import "../lib/public-copy-controls";
</script>

<style>
  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* Open original + Download: equal-width pair, same box as the copy row. */
  .links {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 8px;
  }
  /* :global so slotted Open original (parent scope) and Download match alike */
  .actions :global(a.original),
  .copy-btn {
    display: block;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--panel);
    color: var(--fg);
    font: var(--text-meta) / var(--leading-ui) var(--sans);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    margin: 0;
  }
  .actions :global(a.original:hover),
  .actions :global(a.original:focus-visible),
  .copy-btn:hover,
  .copy-btn:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    outline: none;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .copyrow {
    display: flex;
    gap: 8px;
    min-width: 0;
  }
  .copyrow .ul-select {
    flex: 1;
    min-width: 0;
    padding: 8px 30px 8px 12px;
    background-color: var(--panel);
    font: var(--text-meta) / var(--leading-ui) var(--sans);
    background-position: right 10px center;
  }
  .copy-btn {
    flex: none;
    cursor: pointer;
    min-width: 72px;
  }
  /* One muted line showing what Copy will put on the clipboard. */
  .preview {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font: var(--text-micro) / 1.5 var(--mono);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
