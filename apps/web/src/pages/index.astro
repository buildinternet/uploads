        align-items: center;
        gap: 10px;
        font: 600 14px / 1.4 var(--sans);
        text-decoration: none;
        border-radius: 3px;
        padding: 13px 21px;
        border: 1px solid #e1c8ff;
        background: #bd98eb;
        color: #23182f;
        box-shadow:
          inset 0 2px 0 #dfc5ff,
          0 3px 0 #765492;
