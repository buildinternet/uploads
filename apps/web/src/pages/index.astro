          transform 0.12s,
          box-shadow 0.12s;
      }
      main .cta-solid:hover {
        background: #cdaaf5;
        color: #23182f;
      }
      main .cta-secondary {
        background: var(--cta-bg);
        color: var(--fg);
        border-color: var(--cta-line);
        box-shadow:
          inset 0 2px 0 var(--cta-inset),
          0 3px 0 var(--cta-shadow);
      }
      main .cta-secondary:hover {
        background: var(--cta-hover);
        color: var(--fg);
      }
      main :is(.cta-solid, .cta-secondary):active {
        transform: translateY(2px);
        box-shadow: none;
      }
      .hero-note {
        color: var(--muted);
        font: 12px / 1.5 var(--mono);
      }
      .hero-install {
        margin-top: 23px;
        max-width: 510px;
      }
      .agent-byline {
        margin-top: 14px;
        font-size: 13px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
      }
      .compatibility {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px 32px;
        padding: 22px 0;
        border-block: 1px solid var(--line);
        color: var(--compat);
        font-size: 14px;
      }
      .compatibility .label {
        color: var(--muted);
        font: 12px var(--mono);
        white-space: nowrap;
      }
      /* Logo reel: the list renders twice and slides half its width for a
         seamless loop. Reduced motion shows the first copy, wrapped. */
      .agent-reel {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
      }
      .agent-track {
        display: flex;
        gap: 44px;
        width: max-content;
        margin: 0;
        padding: 0 44px 0 0;
        list-style: none;
        animation: agent-reel 32s linear infinite;
      }
      .agent-reel:hover .agent-track,
      .agent-reel:focus-within .agent-track {
        animation-play-state: paused;
      }
      .agent-track a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        color: inherit;
        text-decoration: none;
        transition: color 0.15s;
      }
      .agent-track a:hover,
      .agent-track a:focus-visible {
        color: var(--fg);
      }
      .agent-track svg {
        width: 18px;
        height: 18px;
        flex: none;
      }
      @keyframes agent-reel {
        to {
          transform: translateX(-50%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .agent-reel {
          mask-image: none;
        }
        .agent-track {
          animation: none;
          width: auto;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 12px 28px;
          padding: 0;
        }
        .agent-track li[aria-hidden] {
          display: none;
        }
      }
      .workflow {
        padding: 76px 0 64px;
      }
      .sect-head {
        font: 600 34px / 1.18 var(--sans);
        letter-spacing: -0.035em;
        text-wrap: balance;
        margin: 12px 0 15px;
      }
      .sect-lede {
        color: var(--body);
        max-width: 640px;
        margin-bottom: 28px;
      }
      /* Terminal illustration — stays on the homepage's dark palette in both
         appearances, so its text tokens don't inherit the page. */
      .example-screen {
        background: #19151f;
        border: 1px solid #342c40;
        border-radius: 7px;
        overflow: hidden;
        color: #f3eee7;
        --fg: #f3eee7;
        --body: #b7b2bd;
        --muted: #9a92a6;
        --accent: #c6a1f5;
        --line: #342c40;
      }
      .line {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .prompt {
        color: var(--accent);
        user-select: none;
        margin-right: 0.5ch;
      }
      .cmd {
        color: var(--fg);
      }
      .out {
        color: var(--muted);
      }
      .out .v {
        color: var(--body);
      }
      .ok {
        color: #a8d7ae;
      }
      .gap {
        height: 1.25em;
      }
      .features {
        padding: 52px 0 60px;
        border-top: 1px solid var(--line);
      }
      .find-block {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 60px;
        align-items: center;
        margin-bottom: 65px;
      }
      .example-screen {
        padding: 22px;
        font: 12px / 1.8 var(--mono);
      }
      .features .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 34px;
        margin-top: 30px;
      }
      .feature {
        border-top: 1px solid var(--line);
        padding-top: 18px;
      }
      .feature h3 {
        font: 600 17px / 1.3 var(--sans);
        margin-bottom: 10px;
      }
      .feature p {
        font-size: 14px;
        color: var(--body);
      }
      .feature code,
      .sect-lede code {
        font: 0.85em var(--mono);
        color: var(--code);
        white-space: nowrap;
        font-variant-ligatures: none;
        font-feature-settings:
          "calt" 0,
          "liga" 0;
      }
      .install {
        border-top: 1px solid var(--line);
        padding: 56px 0 0;
        scroll-margin-top: 28px;
      }
      .faq {
        border-top: 1px solid var(--line);
        padding: 56px 0 8px;
        scroll-margin-top: 28px;
      }
      .faq-list {
        display: grid;
        gap: 10px;
        max-width: 760px;
      }
      .faq-list details {
        background: var(--inset);
        border: 1px solid var(--line);
        border-radius: 7px;
      }
      .faq-list details[open] {
        border-color: var(--edge);
      }
      .faq-list summary {
        cursor: pointer;
        list-style: none;
        font: 600 16px / 1.4 var(--sans);
        padding: 16px 48px 16px 18px;
        position: relative;
      }
      .faq-list summary::-webkit-details-marker {
        display: none;
      }
      .faq-list summary::marker {
        content: "";
      }
      .faq-list summary::after {
        content: "+";
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-52%);
        color: var(--accent);
        font: 500 22px / 1 var(--sans);
      }
      .faq-list details[open] summary::after {
        content: "−";
      }
      .faq-list summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
        border-radius: 6px;
      }
      .faq-a {
        padding: 0 18px 16px;
        color: var(--body);
        font-size: 15px;
      }
      .faq-a p + p {
        margin-top: 10px;
      }
      .faq-a code {
        font: 0.85em var(--mono);
        color: var(--code);
        font-variant-ligatures: none;
        font-feature-settings:
          "calt" 0,
          "liga" 0;
      }
      .install-layout {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 60px;
      }
      .rows {
        display: grid;
        gap: 12px;
        min-width: 0;
      }
      .cmdrow {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 10px;
        background: var(--panel);
        border: 1px solid var(--line);
        padding: 12px 14px;
        border-radius: 4px;
        min-width: 0;
      }
      .cmdrow:has(button[data-copy]) {
        cursor: pointer;
      }
      .cmdrow:has(button[data-copy]):hover {
        border-color: var(--cmd-hover);
      }
      .cmdrow .tag {
        color: var(--muted);
        font: 10px var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        grid-column: 1/-1;
      }
      .cmdtext {
        font: 12px / 1.5 var(--mono);
        min-width: 0;
        overflow-x: auto;
        white-space: nowrap;
      }
      .comment {
        color: var(--muted);
      }
      .agent-desc {
        font-size: 13px;
      }
      .cmdrow button,
      .agent-byline button {
        color: var(--accent);
        background: transparent;
        border: 1px solid var(--chip-line);
        border-radius: 3px;
        padding: 6px 9px;
        font: 11px / 1.4 var(--mono);
        cursor: pointer;
      }
      .cmdrow button:hover,
      .agent-byline button:hover {
        background: var(--chip-hover);
      }
      .cmdrow button.done,
      .agent-byline button.done {
        color: var(--ok);
        border-color: var(--ok);
      }
      .prompt-note {
        font-size: 12px;
        color: var(--muted);
      }
      .cta-row {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 17px;
        margin-top: 27px;
      }
      .cta-note {
        font-size: 12px;
        color: var(--muted);
      }
      code,
      .cmd,
      .screen,
      .example-screen,
      .cmdtext {
        font-variant-ligatures: none;
        font-feature-settings:
          "calt" 0,
          "liga" 0;
      }
      /* Same chrome tokens as `body`, on the light paper. The terminal
         illustration above pins its own colors and does not inherit these. */
      html[data-theme="light"] body {
        --bg: #f7f4ef;
        --fg: #1c1722;
        --body: #4a4454;
        --muted: #6c6576;
        --panel: #fffdfb;
        --line: #e4dce8;
        --accent: #6e349f;
        --link-line: #b89ad0;
        --code: #6e349f;
        --inset: var(--panel);
        --edge: #c9b6dc;
        --cmd-hover: #b89ad0;
        --chip-line: #d5c6e4;
        --chip-hover: #f3eef8;
        --ok: #2a6e34;
        --compat: var(--body);
        --cta-bg: var(--panel);
        --cta-line: #d9cce4;
        --cta-inset: #fff;
        --cta-shadow: #c9bdd6;
        --cta-hover: #f3eef8;
      }
      @media (max-width: 900px) {
        main {
          padding-inline: 28px;
        }
        .hero {
          padding-top: 60px;
          grid-template-columns: 1.2fr 0.8fr;
          gap: 0;
