        flex-wrap: wrap;
        align-items: center;
        gap: 18px 32px;
        padding: 22px 0;
        border-block: 1px solid var(--line);
        color: #c6bfce;
        font-size: 14px;
      }
      .compatibility .label {
        color: var(--muted);
        font: 12px var(--mono);
        margin-right: auto;
      }
      .workflow {
        padding: 76px 0 64px;
      }
      .sect-head {
        font: 600 34px / 1.18 var(--sans);
        letter-spacing: -0.035em;
        text-wrap: balance;
        margin: 12px 0 15px;
      }
      .sect-lede {
        color: var(--body);
        max-width: 640px;
        margin-bottom: 28px;
      }
      .workflow-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 24px;
        align-items: start;
        margin-top: 34px;
      }
      .step-label {
        color: var(--muted);
        font: 12px var(--mono);
        margin: 0 0 14px;
      }
      .step-label span {
        color: var(--accent);
        margin-right: 8px;
      }
      .terminal,
      .example-screen {
        background: #19151f;
        border: 1px solid var(--line);
        border-radius: 7px;
        overflow: hidden;
      }
      .terminal-bar {
        color: var(--muted);
        font: 11px var(--mono);
        padding: 12px 18px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .terminal-lights {
        color: #786487;
        letter-spacing: 5px;
      }
      .screen {
        padding: 25px 20px 30px;
        font: 12px / 1.85 var(--mono);
      }
      .line {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .prompt {
        color: var(--accent);
        user-select: none;
        margin-right: 0.5ch;
      }
      .cmd {
        color: var(--fg);
      }
      .out {
        color: var(--muted);
      }
      .out .v {
        color: var(--body);
      }
      .ok {
        color: #a8d7ae;
      }
      .gap {
        height: 1.25em;
      }
      .ghc-note,
      .flow-note {
        color: var(--muted);
        font-size: 12px;
        margin-top: 15px;
        line-height: 1.65;
      }
      .ghc {
        font: 12px / 1.5 var(--sans);
      }
      .ghc .avatar {
        display: none;
      }
      .ghc .bubble {
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 7px;
        overflow: hidden;
      }
      .ghc .head {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        background: #1c2129;
        border-bottom: 1px solid #30363d;
        padding: 12px 16px;
        color: #8b949e;
      }
      .ghc .head .user {
        color: #e6edf3;
        font-weight: 600;
      }
      .bot-chip {
        border: 1px solid #454c56;
        border-radius: 20px;
        padding: 0 6px;
        font-size: 10px;
      }
      .ghc .body {
        padding: 16px;
      }
      .ghc .imgs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
      }
      .ghc figure {
        margin: 0;
        min-width: 0;
      }
      .ghc .shot {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16/10;
        object-fit: cover;
        border: 1px solid #444c56;
        border-radius: 4px;
      }
      .ghc figcaption {
        font: 11px var(--mono);
        color: #9da7b3;
        margin-top: 8px;
      }
      .skel {
        height: 6px;
        background: #2d333b;
        margin: 9px 0;
        border-radius: 2px;
      }
      .skel.w70 {
        width: 70%;
      }
      .skel.w45 {
        width: 45%;
      }
      .features {
        padding: 52px 0 60px;
        border-top: 1px solid var(--line);
      }
      .find-block {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 60px;
        align-items: center;
        margin-bottom: 65px;
      }
      .example-screen {
        padding: 22px;
        font: 12px / 1.8 var(--mono);
      }
      .features .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 34px;
        margin-top: 30px;
      }
      .feature {
        border-top: 1px solid var(--line);
        padding-top: 18px;
      }
      .feature h3 {
        font: 600 17px / 1.3 var(--sans);
        margin-bottom: 10px;
      }
      .feature p {
        font-size: 14px;
        color: var(--body);
      }
      .feature code,
      .sect-lede code {
        font: 0.85em var(--mono);
        color: #d2b5ef;
        white-space: nowrap;
        font-variant-ligatures: none;
        font-feature-settings:
          "calt" 0,
          "liga" 0;
      }
      .install {
        border-top: 1px solid var(--line);
        padding: 56px 0 0;
        scroll-margin-top: 28px;
      }
      .install-layout {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 60px;
      }
      .rows {
        display: grid;
        gap: 12px;
        min-width: 0;
      }
      .cmdrow {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 10px;
        background: #1b1722;
        border: 1px solid var(--line);
        padding: 12px 14px;
        border-radius: 4px;
        min-width: 0;
      }
      .cmdrow:has(button[data-copy]) {
        cursor: pointer;
      }
      .cmdrow:has(button[data-copy]):hover {
        border-color: #76558d;
      }
      .cmdrow .tag {
        color: var(--muted);
        font: 10px var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        grid-column: 1/-1;
      }
      .cmdtext {
        font: 12px / 1.5 var(--mono);
        min-width: 0;
        overflow-x: auto;
        white-space: nowrap;
      }
      .comment {
        color: var(--muted);
      }
      .agent-desc {
        font-size: 13px;
      }
      .cmdrow button,
      .agent-byline button {
        color: var(--accent);
        background: transparent;
        border: 1px solid #534160;
        border-radius: 3px;
        padding: 6px 9px;
        font: 11px / 1.4 var(--mono);
        cursor: pointer;
      }
      .cmdrow button:hover,
      .agent-byline button:hover {
        background: #30243d;
      }
      .cmdrow button.done,
      .agent-byline button.done {
        color: #a8d7ae;
        border-color: #a8d7ae;
      }
      .prompt-note {
        font-size: 12px;
        color: var(--muted);
      }
      .cta-row {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 17px;
        margin-top: 27px;
      }
      .cta-note {
        font-size: 12px;
        color: var(--muted);
      }
      code,
      .cmd,
      .screen,
      .example-screen,
      .cmdtext {
        font-variant-ligatures: none;
        font-feature-settings:
          "calt" 0,
          "liga" 0;
      }
      @media (max-width: 900px) {
        main {
          padding-inline: 28px;
        }
        .hero {
          padding-top: 60px;
          grid-template-columns: 1.2fr 0.8fr;
          gap: 0;
        }
        h1 {
          font-size: 54px;
        }
        .hero-art {
          margin-right: -15px;
        }
        .workflow-grid,
        .find-block,
        .install-layout {
          gap: 28px;
        }
        .features .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 680px) {
        main {
          padding: 0 22px 60px;
        }
        .hero {
          grid-template-columns: 1fr;
          padding: 46px 0 30px;
        }
        h1 {
          font-size: clamp(44px, 10.7vw, 64px);
          max-width: 510px;
        }
        .hero .eyebrow {
          margin-bottom: 19px;
        }
        .lede {
          font-size: 16px;
          margin-top: 22px;
        }
        .hero-art {
          width: min(350px, 90%);
          margin: 20px auto -5px;
        }
        .compatibility {
          gap: 12px 22px;
          font-size: 12px;
        }
        .compatibility .label {
          flex-basis: 100%;
        }
        .workflow {
          padding: 46px 0;
        }
        .workflow-grid,
        .find-block,
        .install-layout {
          grid-template-columns: 1fr;
          gap: 28px;
        }
        .sect-head {
          font-size: 29px;
        }
        .features {
          padding: 35px 0 42px;
        }
        .find-block {
          margin-bottom: 40px;
        }
        .features .grid {
          gap: 26px 20px;
        }
        .feature p {
          font-size: 13px;
        }
        .install {
          padding-top: 35px;
        }
        .install-layout .cta-row {
          margin-bottom: 8px;
        }
      }
      @media (max-width: 400px) {
        .features .grid {
          grid-template-columns: 1fr;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        main :is(.cta-solid, .cta-secondary) {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <SiteHeader authOrigin={authOrigin} />
    <main>
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow">CLI + MCP</p>
          <h1 id="hero-heading">The upload tool for <span>coding agents.</span></h1>
          <p class="lede">
            Give Claude Code, Codex, and other coding agents a place to upload screenshots,
            recordings, and reports.
          </p>
          <div class="hero-actions">
            <a class="cta-solid" href="#get-started"
              >Get started <span aria-hidden="true">↗</span></a
            >
            <a class="cta-secondary" href="/docs">Read the docs</a>
          </div>
          <p class="hero-note">Stable URLs. GitHub attachments. One command.</p>
          <div class="cmdrow hero-install">
            <span class="cmdtext">npm install -g @buildinternet/uploads</span>
            <button
              type="button"
              data-copy="npm install -g @buildinternet/uploads"
              aria-live="polite">copy</button
            >
          </div>
          <p class="agent-byline">
            Let your agent take it from here <button
              type="button"
              data-copy={agentPrompt}
              aria-live="polite">copy setup prompt</button
            >
          </p>
        </div>
        <figure class="hero-art">
          <img
            src="/brand/upload-dock.png"
            width="1440"
            height="1088"
            fetchpriority="high"
            alt="A purple pixel-art upload dock holding screenshots, recordings, and files"
          />
        </figure>
      </section>
      <div class="compatibility" aria-label="Agent interfaces">
        <span class="label">Fits your workflow</span><span>Claude Code</span><span>Codex</span><span
          >Cursor</span
        ><span>CLI + MCP</span>
      </div>
      <section class="workflow" aria-labelledby="workflow-heading">
        <p class="eyebrow">From local file to pull request</p>
        <h2 class="sect-head" id="workflow-heading">
          Your agent does the work. Uploads brings the proof.
        </h2>
        <p class="sect-lede">
          Capture as you build. Every file gets a stable URL, and with the GitHub App installed,
          staged uploads appear when your PR opens.
        </p>
        <div class="workflow-grid">
          <div>
            <p class="step-label"><span>01</span> Upload while you work</p>
            <section class="terminal" aria-label="uploads.sh terminal">
              <div class="terminal-bar">
                <span class="terminal-lights" aria-hidden="true">▪▪▪</span> ~/your-project
              </div>
              <div class="screen">
                <p class="line out"># capture as you work — no PR yet</p>
                <p class="line">
                  <span class="prompt">$</span>
                  <span class="cmd">uploads put ./after.png</span>
                </p>
                <p class="line out">
                  <span class="ok">✓</span> Uploaded and staged for feat/nav
                </p>
                <div class="gap"></div>
                <p class="line out"># a stable URL, ready to share</p>
                <p class="line">https://…/after.png</p>
                <div class="gap"></div>
                <p class="line out"># open your PR when you’re ready</p>
                <p class="line">
                  <span class="prompt">$</span><span class="cmd">gh pr create</span>
                </p>
              </div>
            </section>

            <p class="flow-note">No pull request yet? Uploads stages files on your branch.</p>
          </div>
          <div>
            <p class="step-label"><span>02</span> Ready for review on GitHub</p>
            <section
              class="ghc"
              aria-label="Mock of the managed GitHub attachments comment, posted by the uploads.sh bot, with a before/after screenshot pair inline"
            >
              <div class="avatar">
                <svg viewBox="0 0 32 32" shape-rendering="crispEdges" aria-hidden="true">
                  <path d="M4 0H28V4H32V28H28V32H4V28H0V4H4Z" fill="#0d1117"></path>
                  <g fill="#c27eff">
                    <path d="M14 4h4v4h-4z M10 6h4v4h-4z M18 6h4v4h-4z M6 8h4v4h-4z M22 8h4v4h-4z"
                    ></path>
                    <path
                      opacity=".55"
                      d="M14 12h4v4h-4z M10 14h4v4h-4z M18 14h4v4h-4z M6 16h4v4h-4z M22 16h4v4h-4z"
                    ></path>
                    <path
                      opacity=".28"
                      d="M14 20h4v4h-4z M10 22h4v4h-4z M18 22h4v4h-4z M6 24h4v4h-4z M22 24h4v4h-4z"
                    ></path>
                  </g>
                </svg>
              </div>
              <div class="bubble">
                <div class="head">
                  {
                    /* Name only — the `bot` chip beside it is what GitHub renders, so
                spelling it "uploads-sh[bot]" here would double-label. */
                  }
                  <span class="user">uploads-sh</span>
                  <span class="bot-chip">bot</span>
                  <span>commented just now</span>
                </div>
                <div class="body">
                  <div class="imgs">
                    <figure>
                      <img
                        class="shot"
                        src="/preview/hero-before.webp"
                        width="640"
                        height="400"
                        loading="lazy"
                        alt="App header with a Follow button overlapping the page title — the before shot"
                      />
                      <figcaption><span>before.webp</span></figcaption>
                    </figure>
                    <figure>
                      <img
                        class="shot"
                        src="/preview/hero-after.webp"
                        width="640"
                        height="400"
                        loading="lazy"
                        alt="The same header with the overlap fixed and the layout clean — the after shot"
                      />
                      <figcaption><span>after.webp</span></figcaption>
                    </figure>
                  </div>
                  <div class="skel w70"></div>
                  <div class="skel w45"></div>
                </div>
              </div>
            </section>
            <p class="ghc-note">
              The bot adds new files automatically, and replaces outdated versions with the latest
              revision (with <a href="/docs/github-app">GitHub App</a> installed).
            </p>
          </div>
        </div>
      </section>
      <section class="features" aria-label="Features">
        <div class="find-block">
          <div>
            <p class="eyebrow">Useful beyond the upload</p>
            <h2 class="sect-head">“Which page was that?”</h2>
            <p class="sect-lede">
              Attach a path (or anything else) with{" "}
              <code>--meta</code>, then <code>uploads find</code> brings it back.
            </p>
          </div>
          <div class="example-screen">
            <p class="line out"># tag it on the way up (source URL, app, etc)</p>
            <p class="line">
              <span class="prompt">$</span>
              <span class="cmd">uploads put ./settings.png --meta path=/account/settings</span>
            </p>
            <div class="gap"></div>
            <p class="line out">
              # find it again later ("Do we have any recent screenshots of settings?")
            </p>
            <p class="line">
              <span class="prompt">$</span>
              <span class="cmd">uploads find path=/settings</span>
            </p>
            <p class="line out">
              <span class="v">gh/you/app/pull/123/settings.webp</span
              >&#32;&#32;path=/account/settings
            </p>
            <p class="line out">
              <span class="v">gh/you/app/pull/456/redesign.webp</span>&#32;&#32;path=/settings
            </p>
          </div>
        </div>
        <h2 class="sect-head later">A small tool. A complete artifact workflow.</h2>
        <div class="grid">
          <div class="feature">
            <h3>Capture and host</h3>
            <p>
              <code>uploads screenshot &lt;url&gt;</code> captures and hosts in one step, with local and
              remote browser support and optional device chrome via <code>--frame</code>.
            </p>
          </div>
          <div class="feature">
            <h3>Point at the change</h3>
            <p>
              Bake hand-drawn boxes, arrows, labels, and solid redactions into a capture with{" "}
              <code>screenshot --annotate</code> or <code>uploads annotate</code> — so reviewers see what
              changed without hunting.
            </p>
          </div>
          <div class="feature">
            <h3>Upload over MCP</h3>
            <p>
              The hosted MCP server at <code>agents.uploads.sh</code> takes files as bytes or a URL and
              posts them to the PR, so agents with no shell, no <code>gh</code>, and no filesystem
              can still attach. GitHub has no public API (yet) for that.
            </p>
          </div>
          <div class="feature">
            <h3>Group into a gallery</h3>
            <p>
              Group uploads into a gallery that can live across multiple PRs — one link for the
              whole set that shows linked issues and pull requests.
            </p>
          </div>
          <div class="feature">
            <h3>More file types</h3>
            <p>
              PDFs, logs, JSON, CSV, Markdown, and zips alongside images and video, so test reports
              and build output get the same stable URLs and list in the same PR comment.
            </p>
          </div>
          <div class="feature">
            <h3>Bring your own bucket</h3>
            <p>
              <a href="/docs/byo-bucket">Connect your own bucket</a> to unlock custom domains and unmetered
              storage — hosted storage works out of the box, your bucket is there when you want it.
            </p>
          </div>
        </div>
      </section>

      <section class="install" id="get-started" aria-label="Install commands">
        <div class="install-layout">
          <div>
            <p class="eyebrow">Ready when you are</p>
            <h2 class="sect-head">Give your agent an upload tool.</h2>
            <p class="sect-lede">
              Install the CLI, sign in, and add the skills and MCP server. Or copy the setup prompt
              and let your agent help.
            </p>
            <div class="cta-row">
              <a class="cta-solid" href="/login" data-home-cta>
                <span data-home-cta-icon aria-hidden="true">
                  <GitHubMark size={15} />
                </span>
                <span data-home-cta-label>Sign in with GitHub</span>
              </a>
              <span class="cta-note" data-home-cta-note
                >free to start in the cloud · open source to self-host</span
              >
            </div>
          </div>
          <div class="rows">
            <div class="cmdrow">
              <span class="tag">cli</span>
              <span class="cmdtext"
                >npm install -g @buildinternet/uploads &amp;&amp; uploads login</span
              >
              <button
                type="button"
                data-copy="npm install -g @buildinternet/uploads && uploads login"
                aria-live="polite">copy</button
              >
            </div>
            <div class="cmdrow">
              <span class="tag">agents</span>
              <span class="cmdtext"
                >uploads install <span class="comment"># skills + mcp</span></span
              >
              <button type="button" data-copy="uploads install" aria-live="polite">copy</button>
            </div>
            <div class="cmdrow">
              <span class="tag">prompt</span>
              <span class="agent-desc">
                <strong>Set up with your agent</strong>
              </span>
              <button type="button" data-copy={agentPrompt} aria-live="polite">copy prompt</button>
            </div>
            <p class="prompt-note">
              <span class="arrow">▸</span> paste the prompt into your coding agent — or read the{
                " "
              }
              <a href="/github-screenshots">full guide</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    {
      /* Sibling of main (not nested) so the full-bleed footer centers on the
        viewport at shell width — same contract as releases.sh. */
    }
    <Footer />

    <script>
      // Auth origin is already set by AuthIndicator in the site header.
      import { getSession } from "../lib/auth-client";
      import {
        clearCachedSessionUser,
        onAstroPageLoad,
        readCachedSessionUser,
        writeCachedSessionUser,
      } from "../lib/account-shell";
      import { readCachedActiveWorkspace, workspaceHomePath } from "../lib/workspaces-nav";

      /** Signed-in landing CTA: last-used workspace when known, else the list. */
      function workspaceHref(): string {
        const ws = readCachedActiveWorkspace();
        return ws ? workspaceHomePath(ws) : "/account/workspaces";
      }

      function paintHomeCta(signedIn: boolean): void {
        const cta = document.querySelector<HTMLAnchorElement>("[data-home-cta]");
        if (!cta) return;
        const icon = cta.querySelector<HTMLElement>("[data-home-cta-icon]");
        const label = cta.querySelector<HTMLElement>("[data-home-cta-label]");
        const note = document.querySelector<HTMLElement>("[data-home-cta-note]");
        if (signedIn) {
          cta.href = workspaceHref();
          if (icon) icon.hidden = true;
          if (label) label.textContent = "Go to workspace";
          if (note) note.hidden = true;
        } else {
          cta.href = "/login";
          if (icon) icon.hidden = false;
          if (label) label.textContent = "Sign in with GitHub";
          if (note) note.hidden = false;
        }
      }

      function bootHomeCta(): void {
        const cta = document.querySelector<HTMLAnchorElement>("[data-home-cta]");
        // Fresh node after ClientRouter body swap; skip double-boot on first paint.
        if (!cta || cta.dataset.booted === "1") return;
        cta.dataset.booted = "1";

        // Optimistic: same sessionStorage cache as the header auth indicator.
        if (readCachedSessionUser()) paintHomeCta(true);

        // Same-origin (#731 phase B): "" is a deliberate value meaning
        // window.__UPLOADS_AUTH_ORIGIN__ was explicitly set to same-origin,
        // not "unset" — so this must not `||`-fallback over an empty string.
        const injectedOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
          .__UPLOADS_AUTH_ORIGIN__;
        const origin = injectedOrigin === undefined ? "https://auth.uploads.sh" : injectedOrigin;

        void getSession(origin).then((result) => {
          if (cta.dataset.booted !== "1" || !document.contains(cta)) return;
          if (result.kind === "signed_in") {
            writeCachedSessionUser(result.session.user);
            paintHomeCta(true);
            return;
          }
          if (result.kind === "signed_out") {
            clearCachedSessionUser();
            paintHomeCta(false);
          }
          // "unavailable": leave optimistic paint (or default sign-in) alone.
        });
      }

      bootHomeCta();
      onAstroPageLoad(bootHomeCta);
    </script>

    <script>
      import { onAstroPageLoad } from "../lib/account-shell";

      function bootCopyControls(): void {
        for (const btn of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
          if (btn.dataset.copyBooted === "1") continue;
          btn.dataset.copyBooted = "1";
          btn.addEventListener("click", async () => {
            if (btn.disabled) return;
            btn.disabled = true;
            const text = btn.getAttribute("data-copy") ?? "";
            const label = btn.textContent ?? "copy";
            let ok = false;
            try {
              await navigator.clipboard.writeText(text);
              ok = true;
            } catch {
              const ta = document.createElement("textarea");
              ta.value = text;
              ta.style.position = "fixed";
              ta.style.opacity = "0";
              document.body.appendChild(ta);
              ta.select();
              try {
                ok = document.execCommand("copy");
              } catch {
                ok = false;
              }
              ta.remove();
            }
            btn.textContent = ok ? "copied ✓" : "copy failed";
            btn.classList.toggle("done", ok);
            setTimeout(() => {
              btn.textContent = label;
              btn.classList.remove("done");
              btn.disabled = false;
            }, 1500);
          });
        }

        // Clicking anywhere on a cmdrow copies — same as CopyAsControls snippet:
        // forward to the real button so feedback/keyboard stay in one place.
        for (const row of document.querySelectorAll<HTMLElement>(".cmdrow")) {
          if (row.dataset.copyBooted === "1") continue;
          row.dataset.copyBooted = "1";
          const copyBtn = row.querySelector("button[data-copy]");
          if (!(copyBtn instanceof HTMLButtonElement)) continue;
          row.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Node)) return;
            if (target === copyBtn || copyBtn.contains(target)) return;
            copyBtn.click();
          });
        }
      }
      bootCopyControls();
      onAstroPageLoad(bootCopyControls);
    </script>
  </body>
</html>
