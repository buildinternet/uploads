      }
      .hero-art img {
        width: 100%;
        height: auto;
        display: block;
      }
      .hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin: 30px 0 21px;
      }
      main .cta-solid,
      main .cta-secondary {
        display: inline-flex;
