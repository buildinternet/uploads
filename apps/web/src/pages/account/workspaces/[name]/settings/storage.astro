---
/**
 * Retired: bucket configuration moved to the Storage tab's `#bucket`
 * section (`components/workspace/StorageBucketSection.astro`). 301 so old
 * bookmarks and links land there.
 */
import { isBrowseWorkspace } from "../../../../../lib/workspace-browse-url";
import { legacyWorkspaceRedirect } from "../../../../../lib/workspace-route-redirects";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");
return Astro.redirect(
  legacyWorkspaceRedirect("settings-storage", workspace, Astro.url.search),
  301,
);
---
