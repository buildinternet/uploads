---
/**
 * Retired: the Screenshots tab is the Files tab's By page view.
 * `?view=recent` becomes `view=pages&sort=recent`; every other param carries
 * over (`legacyWorkspaceRedirect`).
 */
import { isBrowseWorkspace } from "../../../../lib/workspace-browse-url";
import { legacyWorkspaceRedirect } from "../../../../lib/workspace-route-redirects";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");
return Astro.redirect(legacyWorkspaceRedirect("screenshots", workspace, Astro.url.search), 301);
---
