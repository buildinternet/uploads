---
/**
 * Workspace galleries tab: explainer, a grid/list of galleries (cover
 * thumbnail, name, items, linked PR/issues, updated) from
 * GET /me/workspaces/:name/galleries, and a layout toggle. Grid is the
 * default — a cover thumbnail per gallery makes contents scannable in a way
 * the text table can't. CLI help moved to /docs/galleries, linked from the
 * rail tip.
 */
import { env } from "cloudflare:workers";
import WorkspaceLayout from "../../../../layouts/WorkspaceLayout.astro";
import { getMyWorkspaceGalleries, getWorkspaceSummary } from "../../../../lib/api-client";
import { serverApiFetchImpl } from "../../../../lib/api-proxy";
import { resolveSignedInOrigins } from "../../../../lib/signed-in-page";
import { isBrowseWorkspace } from "../../../../lib/workspace-browse-url";
import { resolveGalleriesView } from "../../../../lib/workspace-galleries-view";
import {
  renderGalleriesHtml,
  renderGalleriesPlaceholderForView,
  renderGalleriesViewToggleHtml,
} from "../../../../lib/workspace-ui";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");

// SSR has no localStorage, so only the URL `?view=` can steer first paint;
// storage (a return visitor's stored choice) is applied client-side. Absent
// both, this is the module default, "grid".
const ssrView = resolveGalleriesView(Astro.url.search, null);

const tip = {
  body: "Link a gallery to a PR and the public link stays current as you add shots.",
  href: "/docs/galleries",
  linkLabel: "Working with galleries",
};

// SSR-first: when the request carries a session and the workspace resolves,
// fetch galleries server-side so first paint has real rows. Only render the
// list when there IS data — getMyWorkspaceGalleries conflates empty and error,
// so an empty/failed result falls back to the placeholder and the client script
// paints the correct empty-state or error.
const { apiOrigin } = resolveSignedInOrigins();
const cookie = Astro.request.headers.get("cookie") ?? "";
let ssrGalleriesHtml: string | null = null;
if (cookie.trim()) {
  const fetchImpl = serverApiFetchImpl(env, Astro.request);
  const [summary, galleries] = await Promise.all([
    getWorkspaceSummary(apiOrigin, workspace, { cookie, fetchImpl }),
    getMyWorkspaceGalleries(apiOrigin, workspace, { cookie, fetchImpl }),
  ]);
  if (summary.kind === "success" && galleries.length > 0) {
    ssrGalleriesHtml = renderGalleriesHtml(galleries, ssrView);
  }
}
---

<WorkspaceLayout workspace={workspace} tip={tip} showQuickActions={false}>
  <div id="ws-status" class="ul-callout status" role="status" hidden></div>
  <button id="ws-retry" type="button" hidden>Try again</button>

  <section class="card settings-page">
    <div class="settings-section" id="ws-galleries-card">
      <div class="ws-page-header">
        <div class="ws-title-block">
          <h2>Galleries</h2>
          <p class="settings-note muted">Ordered sets of media behind one public link.</p>
        </div>
        {
          /* Layout toggle. Hidden by the client script while the empty-state
            CTA is up (nothing to lay out). */
        }
        <div
          id="ws-gallery-viewtoggle"
          class="ws-gallery-header-actions"
          set:html={renderGalleriesViewToggleHtml(ssrView)}
        />
      </div>

      <div
        id="ws-galleries"
        set:html={ssrGalleriesHtml ?? renderGalleriesPlaceholderForView(ssrView)}
      />
    </div>
  </section>

  <script>
    import {
      getPageVisit,
      isCurrentPageVisit,
      onAstroPageLoad,
      onSession,
      requireElement,
    } from "../../../../lib/account-shell";
    import { getMyWorkspaceGalleries, type GallerySummary } from "../../../../lib/api-client";
    import { resolveActiveWorkspace } from "../../../../lib/workspace-browse-url";
    import {
      resolveGalleriesView,
      replaceGalleriesView,
      type GalleriesView,
    } from "../../../../lib/workspace-galleries-view";
    import { loadWorkspaceSummary } from "../../../../lib/workspace-summary-source";
    import { bindMediaFallbacks } from "../../../../lib/media-load";
    import {
      bindCopyButtons,
      renderGalleriesEmptyHtml,
      renderGalleriesHtml,
    } from "../../../../lib/workspace-ui";

    onAstroPageLoad(() => {
      if (!document.getElementById("ws-galleries")) return;

      const page = "workspace galleries";
      const visit = getPageVisit();
      const stillHere = (): boolean => isCurrentPageVisit(visit);
      const w = window as unknown as {
        __UPLOADS_API_ORIGIN__: string;
        __UPLOADS_ACTIVE_WORKSPACE__: string;
      };
      const apiOrigin = w.__UPLOADS_API_ORIGIN__;
      // Prefer the URL — ClientRouter sibling nav can leave the layout global
      // stale if the boot script failed to re-apply. Pathname is always current.
      const workspaceName = resolveActiveWorkspace(
        window.location.pathname,
        w.__UPLOADS_ACTIVE_WORKSPACE__ || "",
      );

      const statusEl = requireElement<HTMLElement>("#ws-status", page);
      const retryBtn = requireElement<HTMLButtonElement>("#ws-retry", page);
      const galleriesCard = requireElement<HTMLElement>("#ws-galleries-card", page);
      const galleriesEl = requireElement<HTMLElement>("#ws-galleries", page);
      const toggleEl = requireElement<HTMLElement>("#ws-gallery-viewtoggle", page);

      // Copy button in the empty-state CTA (bound once on the card root; the
      // grid/list rows carry no copy buttons of their own).
      bindCopyButtons(galleriesCard);

      // Wire broken-cover fallbacks on the SSR-painted grid (its images may
      // have already 404'd before this script ran — `bindMediaFallbacks`
      // handles the already-failed case, unlike a plain `error` listener).
      // `document` scope (not `galleriesEl`): matches the public `/g/` grid and
      // sidesteps the wrangler-types `HTMLElement`→`ParentNode` drift; the
      // per-root `data-mediaBound` guard keeps repeat scans idempotent.
      bindMediaFallbacks(document);

      // URL + localStorage; the toggle rewrites both. Held in-memory so the
      // toggle can re-render the last-loaded rows without a refetch.
      let currentView: GalleriesView = resolveGalleriesView(window.location.search);
      let lastGalleries: GallerySummary[] | null = null;

      function syncTogglePressed(): void {
        for (const btn of toggleEl.querySelectorAll<HTMLButtonElement>("[data-gallery-view]")) {
          btn.setAttribute(
            "aria-pressed",
            btn.dataset.galleryView === currentView ? "true" : "false",
          );
        }
      }
      syncTogglePressed();

      function showError(message: string, retry = true): void {
        if (!stillHere()) return;
        statusEl.hidden = false;
        statusEl.textContent = message;
        statusEl.dataset.state = "error";
        // The card stays on screen. A failed galleries fetch does not
        // invalidate the heading or the explainer. This innerHTML assignment
        // also discards the placeholder's `aria-busy` wrapper wholesale, so
        // there is nothing left to un-busy.
        galleriesEl.innerHTML = "";
        toggleEl.hidden = true;
        retryBtn.hidden = !retry;
      }

      function paint(): void {
        if (!lastGalleries) return;
        if (!lastGalleries.length) {
          galleriesEl.innerHTML = renderGalleriesEmptyHtml(
            'uploads gallery create --title "Release screenshots"',
          );
          // Nothing to lay out — the toggle would be inert.
          toggleEl.hidden = true;
          return;
        }
        toggleEl.hidden = false;
        galleriesEl.innerHTML = renderGalleriesHtml(lastGalleries, currentView);
        // Grid covers are fresh DOM each paint — (re)bind their fallbacks.
        bindMediaFallbacks(document);
      }

      function renderGalleries(galleries: GallerySummary[]): void {
        if (!stillHere()) return;
        lastGalleries = galleries;
        paint();
      }

      toggleEl.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-gallery-view]");
        if (!btn) return;
        const next = btn.dataset.galleryView as GalleriesView;
        if (next !== "grid" && next !== "list") return;
        if (next === currentView) return;
        currentView = next;
        replaceGalleriesView(next);
        syncTogglePressed();
        paint();
      });

      async function loadGalleries(): Promise<void> {
        if (!stillHere()) return;
        statusEl.hidden = true;
        statusEl.removeAttribute("data-state");
        retryBtn.hidden = true;

        const result = await loadWorkspaceSummary(apiOrigin, workspaceName);
        if (!stillHere()) return;
        if (result.kind === "unavailable") {
          // `not_found` from /summary is the not-a-member case: the endpoint
          // answers membership and existence together, so a 404 here means
          // "not yours" and is not worth a retry button.
          if (result.reason === "not_found") {
            showError("You don’t have access to this workspace.", false);
            return;
          }
          showError("Workspaces are temporarily unavailable. Check the local stack or try again.");
          return;
        }

        const ws = result.workspace;
        document.title = `Galleries · ${ws.organization.name || ws.workspace} · uploads.sh`;

        void getMyWorkspaceGalleries(apiOrigin, ws.workspace).then(renderGalleries);
      }

      retryBtn.addEventListener("click", () => {
        void loadGalleries();
      });

      onSession(() => {
        void loadGalleries();
      });
    });
  </script>
</WorkspaceLayout>
