---
/** Retired: galleries are listed on the Links tab. 301 keeps old links working. */
import { isBrowseWorkspace } from "../../../../lib/workspace-browse-url";
import { legacyWorkspaceRedirect } from "../../../../lib/workspace-route-redirects";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");
return Astro.redirect(legacyWorkspaceRedirect("galleries", workspace, Astro.url.search), 301);
---
