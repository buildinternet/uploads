---
/**
 * Temporary hop while slice 3 lands: the bucket browser moved to `/storage`.
 * Task 6 replaces this page with the Files By page view. 302, not 301, so no
 * browser caches this intermediate state.
 */
import { isBrowseWorkspace, workspaceStoragePath } from "../../../../lib/workspace-browse-url";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");
return Astro.redirect(`${workspaceStoragePath(workspace)}${Astro.url.search}`, 302);
---
