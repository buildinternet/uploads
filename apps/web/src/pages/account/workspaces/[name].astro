---
/**
 * Bare workspace URL. Files is the workspace home; old bucket-browser deep
 * links (`?path=`, `?prefix=`, `meta.*`, `name=`, `view=list|grid`) go to
 * Storage instead. The decision is `legacyWorkspaceRedirect`, so the spec's
 * redirect table is unit-tested.
 */
import { isBrowseWorkspace } from "../../../lib/workspace-browse-url";
import { legacyWorkspaceRedirect } from "../../../lib/workspace-route-redirects";

export const prerender = false;

const nameParam = Astro.params.name ?? "";
const workspace = isBrowseWorkspace(nameParam) ? nameParam : "";
if (!workspace) return Astro.redirect("/account/workspaces");
return Astro.redirect(legacyWorkspaceRedirect("root", workspace, Astro.url.search), 301);
---
