---
import { env } from "cloudflare:workers";
import AccountLayout from "../../layouts/AccountLayout.astro";
import {
  loadProfilePageData,
  renderSessionsHtml,
  renderSignInMethodsHtml,
  renderWeeklyDigestHtml,
} from "../../lib/account-profile-ui";
import { serverAuthFetchImpl } from "../../lib/auth-proxy";
import { resolveSignedInOrigins } from "../../lib/signed-in-page";
import { renderDetailListPlaceholderHtml, renderEmptyStateHtml } from "../../lib/workspace-ui";

export const prerender = false;

const { authOrigin } = resolveSignedInOrigins();
const initial = await loadProfilePageData(
  authOrigin,
  Astro.request.headers.get("cookie") ?? "",
  serverAuthFetchImpl(env, Astro.request),
);
const accountsReady = initial.accounts !== null;
const sessionsReady = initial.sessions !== null;
// A signed-in profile view always has at least the current session, so this
// is a defensive edge, not the common case — kept in parity with the
// client's original branching (hide the list, show status text) rather than
// letting an empty <ul> render.
const sessionsEmpty = sessionsReady && (initial.sessions?.length ?? 0) === 0;
---

<AccountLayout section="profile">
  {/* One surface, hairline sections — avoids stacked cards + nested list boxes. */}
  <section class="card settings-page">
    <div class="settings-section">
      <h2>Account</h2>
      <dl class="kv">
        <dt>Email</dt><dd id="acct-email">{initial.user?.email ?? ""}</dd>
        <dt>Name</dt><dd id="acct-name">{initial.user ? initial.user.name || "—" : ""}</dd>
        <dt>Role</dt><dd id="acct-role">{initial.user ? initial.user.role || "member" : ""}</dd>
      </dl>
      <p class="muted settings-note">From your sign-in provider.</p>
    </div>

    <div class="settings-section">
      <h2>Email notifications</h2>
      {/* One .notify-group per channel or cadence; Slack alerts slot in as another group. */}
      <div class="notify-group">
        <h3 class="notify-group__title">Workspace alerts</h3>
        <label class="notify-row">
          <input
            type="checkbox"
            id="notify-member-join"
            checked={initial.user?.notifyMemberJoin ?? true}
          />
          <span>Someone joins a workspace I administer</span>
        </label>
        <label class="notify-row">
          <input
            type="checkbox"
            id="notify-usage-limits"
            checked={initial.user?.notifyUsageLimits ?? true}
          />
          <span>A workspace I administer nears its usage limit</span>
        </label>
      </div>
      <div class="notify-group">
        <h3 class="notify-group__title">Weekly digests</h3>
        <p class="muted settings-note">
          Off until you turn them on. An unsubscribe link turns off that workspace only. The admin
          pulse is for workspaces you administer.
        </p>
        <div
          id="weekly-digest-list"
          class="digest-table-wrap"
          set:html={initial.digestWorkspaces
            ? renderWeeklyDigestHtml(initial.digestWorkspaces)
            : `<p class="muted settings-note">Couldn’t load weekly digest settings.</p>`}
        />
      </div>
      <p id="notify-status" class="muted settings-note" role="status" aria-live="polite"></p>
    </div>

    <div class="settings-section" id="slack">
      <h2>Slack</h2>
      <label class="notify-row">
        <input
          type="checkbox"
          id="notify-slack-holds"
          checked={initial.user?.notifySlackHolds ?? true}
        />
        <span>Message me in Slack when an upload is held for review.</span>
      </label>
      <p class="muted settings-note">
        You get the message for your own uploads. When an upload has no known uploader, workspace
        admins get it. It needs a connected Slack account.
      </p>
      <div id="slack-links" class="slack-links" aria-busy="true">
        <p class="muted settings-note">Loading Slack connections…</p>
      </div>
      <p id="slack-status" class="muted settings-note" role="status" aria-live="polite"></p>
    </div>

    <div class="settings-section">
      <h2>Sign-in methods</h2>
      <div id="accounts-status" class="muted detail-status" hidden></div>
      <ul
        class="detail-list"
        id="accounts-list"
        aria-busy={accountsReady ? "false" : "true"}
        set:html={accountsReady
          ? renderSignInMethodsHtml(initial.accounts ?? [], initial.githubInfo)
          : renderDetailListPlaceholderHtml()}
      />
      <p id="accounts-error" class="detail-error" role="alert" hidden></p>
    </div>

    <div class="settings-section">
      <h2>Sessions</h2>
      <div id="cli-upgrade" class="ul-callout cli-upgrade" hidden role="status">
        <span class="ul-callout__title">CLI update</span>
        <p id="cli-upgrade-msg" class="cli-upgrade__msg"></p>
        <div class="cli-upgrade__actions">
          <div class="command">
            <code id="cli-upgrade-cmd"></code>
            <button type="button" id="cli-upgrade-copy" data-copy="" aria-live="polite">copy</button
            >
          </div>
          <button type="button" class="text-btn" id="cli-upgrade-dismiss">Dismiss</button>
        </div>
      </div>
      <div
        id="sessions-status"
        class="muted detail-status"
        hidden={sessionsEmpty ? undefined : true}
        set:html={sessionsEmpty
          ? renderEmptyStateHtml({ title: "No active sessions.", variant: "inline" })
          : ""}
      />
      <ul
        class="detail-list"
        id="sessions-list"
        aria-busy={sessionsReady ? "false" : "true"}
        hidden={sessionsEmpty ? true : undefined}
        set:html={sessionsReady
          ? renderSessionsHtml(initial.sessions ?? [], initial.currentToken)
          : renderDetailListPlaceholderHtml()}
      />
      <div id="sessions-recover" class="sessions-recover" hidden>
        <p class="muted">Couldn’t load sessions — sign in again to refresh.</p>
        <a class="text-btn" id="sessions-reauth" href="/login">Sign in again</a>
      </div>
      <p id="sessions-error" class="detail-error" role="alert" hidden></p>
    </div>
  </section>

  <Fragment slot="rail">
    <div class="ws-rail" data-account-rail>
      <section class="ws-rail__section">
        <div class="ws-rail__head">
          <span class="ws-rail__label">tip</span>
          <span class="ws-rail__rule"></span>
        </div>
        <p class="account-rail-tip">
          Have a workspace under another email? Connect GitHub here (or sign in with that email via
          magic link, then connect) to link the two.
        </p>
      </section>
    </div>
  </Fragment>

  <style>
    /* Section chrome is shared via account-shell.css; tip body is profile-only. */
    .account-rail-tip {
      margin: 0;
      color: var(--muted);
      font-size: var(--text-meta);
      line-height: 1.55;
      text-wrap: pretty;
    }
    .cli-upgrade {
      margin: 0 0 14px;
    }
    .cli-upgrade__msg {
      margin: 0 0 10px;
    }
    .cli-upgrade__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 14px;
    }
    .cli-upgrade .command {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0;
    }
    .notify-group + .notify-group {
      margin-top: 20px;
    }
    .notify-group__title {
      margin: 0 0 10px;
      color: var(--fg);
      font-size: var(--text-meta);
      font-weight: var(--weight-semibold);
    }
    .notify-group .settings-note {
      margin: 0 0 14px;
    }
    .notify-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
      font-size: var(--text-meta);
      color: var(--body);
    }
    .notify-row input {
      margin: 0;
      flex: none;
    }
    .slack-links {
      margin-top: 12px;
    }
    /* Injected with innerHTML by the client, so :global like the digest table. */
    .slack-links :global(.slack-empty__actions) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 14px;
      margin: 10px 0 0;
    }
    /* The digest table is injected with set:html (and re-rendered on the
       client), so its rules must be :global — scoped selectors never match. */
    .digest-table-wrap {
      overflow-x: auto;
    }
    .digest-table-wrap :global(.digest-table) {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-meta);
      line-height: 1.4;
    }
    .digest-table-wrap :global(th),
    .digest-table-wrap :global(td) {
      padding: 10px 12px 10px 0;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: middle;
    }
    .digest-table-wrap :global(thead th) {
      padding-top: 0;
      color: var(--muted);
      font: var(--weight-medium) var(--text-micro) / 1 var(--sans);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .digest-table-wrap :global(tbody tr:last-child > *) {
      border-bottom: 0;
    }
    .digest-table-wrap :global(tbody th) {
      font-weight: inherit;
    }
    .digest-table-wrap :global(.digest-table__toggle) {
      width: 9rem;
      padding-right: 0;
      text-align: center;
    }
    .digest-table-wrap :global(.digest-table__toggle input) {
      margin: 0;
    }
    .digest-table-wrap :global(.digest-table__name) {
      color: var(--fg);
      font-weight: var(--weight-semibold);
    }
    .digest-table-wrap :global(.digest-table__role),
    .digest-table-wrap :global(.digest-table__na) {
      color: var(--muted);
      font-size: var(--text-micro);
    }
    .digest-table-wrap :global(.digest-table__role) {
      margin-left: 6px;
    }
    @media (max-width: 560px) {
      .digest-table-wrap :global(.digest-table__toggle) {
        width: 5.5rem;
        padding-left: 8px;
      }
      .digest-table-wrap :global(thead th) {
        white-space: normal;
        line-height: 1.3;
      }
      .digest-table-wrap :global(.digest-table__role) {
        display: block;
        margin: 2px 0 0;
      }
    }
  </style>

  <script>
    import { onAstroPageLoad, onSession, requireElement } from "../../lib/account-shell";
    import {
      renderSessionsHtml,
      renderSignInMethodsHtml,
      renderSlackLinksHtml,
      renderWeeklyDigestHtml,
    } from "../../lib/account-profile-ui";
    import { listSlackLinks, unlinkSlack } from "../../lib/slack-connect";
    import {
      getAccountInfo,
      getSession,
      linkGitHub,
      listAccounts,
      listDigestPreferences,
      listSessions,
      revokeSession,
      updateDigestPreference,
      updateNotifyMemberJoin,
      updateNotifySlackHolds,
      updateNotifyUsageLimits,
      type AuthSession,
    } from "../../lib/auth-client";
    import {
      bestCliVersion,
      dismissUpgrade,
      isUpgradeDismissed,
      resolveUpgradePrompt,
    } from "../../lib/cli-upgrade";
    import { renderDetailListPlaceholderHtml, renderEmptyStateHtml } from "../../lib/workspace-ui";

    onAstroPageLoad(() => {
      if (!document.getElementById("acct-email")) return;

      const authOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
        .__UPLOADS_AUTH_ORIGIN__;

      function showStatus(
        el: HTMLElement,
        content: string,
        { html = false }: { html?: boolean } = {},
      ): void {
        el.hidden = false;
        if (html) {
          el.innerHTML = content;
        } else {
          el.textContent = content;
        }
      }

      function setAccountsError(message: string | null): void {
        const error = requireElement<HTMLElement>("#accounts-error", "account profile");
        error.textContent = message ?? "";
        error.hidden = !message;
      }

      async function loadAccounts(): Promise<void> {
        const status = requireElement<HTMLElement>("#accounts-status", "account profile");
        const list = requireElement<HTMLUListElement>("#accounts-list", "account profile");
        status.hidden = true;
        list.hidden = false;
        list.setAttribute("aria-busy", "true");
        list.innerHTML = renderDetailListPlaceholderHtml();

        const accounts = await listAccounts(authOrigin);
        if (accounts === null) {
          list.hidden = true;
          list.removeAttribute("aria-busy");
          showStatus(status, "Couldn’t load sign-in methods.");
          return;
        }

        // Live GitHub profile when linked (account-info needs list-accounts id).
        const github = accounts.find((a) => a.providerId === "github");
        const githubInfo = github
          ? await getAccountInfo(authOrigin, {
              providerId: "github",
              accountId: github.accountId,
            })
          : null;

        status.hidden = true;
        list.hidden = false;
        list.removeAttribute("aria-busy");
        list.innerHTML = renderSignInMethodsHtml(accounts, githubInfo);
      }

      let currentToken: string | undefined;

      async function maybeShowCliUpgrade(sessions: AuthSession[]): Promise<void> {
        const box = requireElement<HTMLElement>("#cli-upgrade", "account profile");
        const msg = requireElement<HTMLElement>("#cli-upgrade-msg", "account profile");
        const cmd = requireElement<HTMLElement>("#cli-upgrade-cmd", "account profile");
        const copyBtn = requireElement<HTMLButtonElement>("#cli-upgrade-copy", "account profile");
        box.hidden = true;

        const current = bestCliVersion(sessions);
        if (!current) return;

        let latest: string | undefined;
        try {
          const res = await fetch("/cli-version.json", { credentials: "same-origin" });
          if (!res.ok) return;
          const body = (await res.json()) as { latest?: unknown };
          if (typeof body.latest === "string") latest = body.latest;
        } catch {
          return;
        }

        const prompt = resolveUpgradePrompt(current, latest);
        if (!prompt || isUpgradeDismissed(prompt.latest, sessionStorage)) return;

        msg.textContent = prompt.message;
        cmd.textContent = prompt.installCmd;
        copyBtn.dataset.copy = prompt.installCmd;
        box.hidden = false;
        box.dataset.latest = prompt.latest;
      }

      async function loadSessions(): Promise<void> {
        const status = requireElement<HTMLElement>("#sessions-status", "account profile");
        const list = requireElement<HTMLUListElement>("#sessions-list", "account profile");
        const recover = requireElement<HTMLElement>("#sessions-recover", "account profile");
        const reauth = requireElement<HTMLAnchorElement>("#sessions-reauth", "account profile");
        const error = requireElement<HTMLElement>("#sessions-error", "account profile");
        const upgradeBox = requireElement<HTMLElement>("#cli-upgrade", "account profile");
        error.hidden = true;
        status.hidden = true;
        list.hidden = false;
        list.setAttribute("aria-busy", "true");
        list.innerHTML = renderDetailListPlaceholderHtml();
        recover.hidden = true;
        upgradeBox.hidden = true;

        // Point recovery at this page so re-auth lands back on the sessions list.
        reauth.href = `/login?callbackURL=${encodeURIComponent(`${location.origin}/account/profile`)}`;

        const [sessionResult, sessions] = await Promise.all([
          getSession(authOrigin),
          listSessions(authOrigin),
        ]);

        if (sessionResult.kind === "signed_in") {
          const token = sessionResult.session.session?.token;
          currentToken = typeof token === "string" ? token : undefined;
        }

        if (sessions === null) {
          list.hidden = true;
          list.removeAttribute("aria-busy");
          status.hidden = true;
          recover.hidden = false;
          return;
        }
        if (!sessions.length) {
          list.hidden = true;
          list.removeAttribute("aria-busy");
          showStatus(
            status,
            renderEmptyStateHtml({ title: "No active sessions.", variant: "inline" }),
            {
              html: true,
            },
          );
          return;
        }

        status.hidden = true;
        list.hidden = false;
        list.removeAttribute("aria-busy");
        list.innerHTML = renderSessionsHtml(sessions, currentToken ?? null);

        void maybeShowCliUpgrade(sessions);
      }

      requireElement<HTMLElement>("#cli-upgrade", "account profile").addEventListener(
        "click",
        (event) => {
          void (async () => {
            const target = event.target as HTMLElement;
            const dismiss = target.closest<HTMLButtonElement>("#cli-upgrade-dismiss");
            if (dismiss) {
              const box = requireElement<HTMLElement>("#cli-upgrade", "account profile");
              const latest = box.dataset.latest;
              if (latest) dismissUpgrade(latest, sessionStorage);
              box.hidden = true;
              return;
            }
            const button = target.closest<HTMLButtonElement>("#cli-upgrade-copy");
            if (!button?.dataset.copy) return;
            try {
              await navigator.clipboard.writeText(button.dataset.copy);
              const previous = button.textContent;
              button.textContent = "copied ✓";
              setTimeout(() => {
                button.textContent = previous;
              }, 1500);
            } catch {
              // Clipboard blocked.
            }
          })();
        },
      );

      requireElement<HTMLUListElement>("#sessions-list", "account profile").addEventListener(
        "click",
        (event) => {
          void (async () => {
            const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
              "button[data-revoke]",
            );
            if (!button?.dataset.revoke) return;
            button.disabled = true;
            button.textContent = "Signing out…";
            const error = requireElement<HTMLElement>("#sessions-error", "account profile");
            error.hidden = true;
            if (!(await revokeSession(authOrigin, button.dataset.revoke))) {
              error.textContent = "Couldn’t sign out that session.";
              error.hidden = false;
              button.disabled = false;
              button.textContent = "Sign out";
              return;
            }
            await loadSessions();
          })();
        },
      );

      requireElement<HTMLUListElement>("#accounts-list", "account profile").addEventListener(
        "click",
        (event) => {
          void (async () => {
            const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
              "button[data-connect-github]",
            );
            if (!button) return;
            setAccountsError(null);
            button.disabled = true;
            button.textContent = "Redirecting…";
            const returnTo = `${location.origin}/account/profile`;
            if (!(await linkGitHub(authOrigin, returnTo))) {
              setAccountsError("GitHub linking isn’t available right now.");
              button.disabled = false;
              button.textContent = "Connect";
            }
          })();
        },
      );

      // Better Auth link-social failures redirect back with ?error=.
      const linkError = new URLSearchParams(location.search).get("error");
      if (linkError) {
        setAccountsError(
          linkError === "account_already_linked_to_different_user"
            ? "That GitHub account is already linked to a different uploads.sh user."
            : "Couldn’t connect GitHub. Try again.",
        );
        const clean = new URL(location.href);
        clean.searchParams.delete("error");
        clean.searchParams.delete("error_description");
        history.replaceState(null, "", clean.pathname + clean.search + clean.hash);
      }

      const notifyToggle = document.getElementById("notify-member-join") as HTMLInputElement | null;
      const usageToggle = document.getElementById("notify-usage-limits") as HTMLInputElement | null;
      const notifyStatus = document.getElementById("notify-status");
      function setNotifyStatus(message: string): void {
        if (notifyStatus) notifyStatus.textContent = message;
      }
      // Account-wide toggles share one status line and the same save-and-revert dance.
      function wireNotifyToggle(
        el: HTMLInputElement | null,
        save: (origin: string, value: boolean) => Promise<boolean>,
      ): void {
        el?.addEventListener("change", () => {
          void (async () => {
            const desired = el.checked;
            el.disabled = true;
            setNotifyStatus("Saving…");
            const ok = await save(authOrigin, desired);
            if (!ok) {
              el.checked = !desired;
              setNotifyStatus("Couldn’t save — try again.");
            } else {
              setNotifyStatus(desired ? "Notifications on." : "Notifications off.");
            }
            el.disabled = false;
          })();
        });
      }
      wireNotifyToggle(notifyToggle, updateNotifyMemberJoin);
      wireNotifyToggle(usageToggle, updateNotifyUsageLimits);

      const apiOrigin = (window as unknown as { __UPLOADS_API_ORIGIN__: string })
        .__UPLOADS_API_ORIGIN__;
      const slackToggle = document.getElementById("notify-slack-holds") as HTMLInputElement | null;
      const slackLinks = document.getElementById("slack-links");
      const slackStatus = document.getElementById("slack-status");
      function setSlackStatus(message: string): void {
        if (slackStatus) slackStatus.textContent = message;
      }
      slackToggle?.addEventListener("change", () => {
        void (async () => {
          const desired = slackToggle.checked;
          slackToggle.disabled = true;
          setSlackStatus("Saving…");
          const ok = await updateNotifySlackHolds(authOrigin, desired);
          if (!ok) {
            slackToggle.checked = !desired;
            setSlackStatus("Couldn’t save — try again.");
          } else {
            setSlackStatus(desired ? "Slack messages on." : "Slack messages off.");
          }
          slackToggle.disabled = false;
        })();
      });
      async function loadSlackLinks(): Promise<void> {
        if (!slackLinks) return;
        const links = await listSlackLinks(apiOrigin);
        slackLinks.innerHTML = renderSlackLinksHtml(links);
        slackLinks.setAttribute("aria-busy", "false");
      }
      slackLinks?.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
          "[data-slack-unlink]",
        );
        const teamId = button?.dataset.teamId;
        const slackUserId = button?.dataset.slackUserId;
        if (!button || !teamId || !slackUserId) return;
        void (async () => {
          button.disabled = true;
          setSlackStatus("Disconnecting…");
          const ok = await unlinkSlack(apiOrigin, { teamId, slackUserId });
          if (!ok) {
            button.disabled = false;
            setSlackStatus("Couldn’t disconnect — try again.");
            return;
          }
          setSlackStatus("Disconnected.");
          await loadSlackLinks();
        })();
      });

      const digestList = document.getElementById("weekly-digest-list");
      async function loadWeeklyDigests(): Promise<void> {
        if (!digestList) return;
        const workspaces = await listDigestPreferences(authOrigin);
        digestList.innerHTML = workspaces
          ? renderWeeklyDigestHtml(workspaces)
          : `<p class="muted settings-note">Couldn’t load weekly digest settings.</p>`;
      }
      digestList?.addEventListener("change", (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement)) return;
        const organizationId = input.dataset.orgId;
        const kind = input.dataset.digest;
        if (!organizationId || (kind !== "member" && kind !== "admin")) return;
        void (async () => {
          const desired = input.checked;
          input.disabled = true;
          setNotifyStatus("Saving…");
          const ok = await updateDigestPreference(
            authOrigin,
            organizationId,
            kind === "admin"
              ? { notifyWeeklyWorkspaceDigest: desired }
              : { notifyWeeklyDigest: desired },
          );
          if (!ok) {
            input.checked = !desired;
            setNotifyStatus("Couldn’t save — try again.");
          } else {
            setNotifyStatus(desired ? "Notifications on." : "Notifications off.");
          }
          input.disabled = false;
        })();
      });

      onSession((user) => {
        requireElement<HTMLElement>("#acct-email", "account profile").textContent = user.email;
        requireElement<HTMLElement>("#acct-name", "account profile").textContent = user.name || "—";
        requireElement<HTMLElement>("#acct-role", "account profile").textContent =
          user.role || "member";
        if (notifyToggle && typeof user.notifyMemberJoin === "boolean") {
          notifyToggle.checked = user.notifyMemberJoin;
        }
        if (usageToggle && typeof user.notifyUsageLimits === "boolean") {
          usageToggle.checked = user.notifyUsageLimits;
        }
        if (slackToggle && typeof user.notifySlackHolds === "boolean") {
          slackToggle.checked = user.notifySlackHolds;
        }
        void loadSlackLinks();
        void loadWeeklyDigests();
        void loadAccounts();
        void loadSessions();
      });
    });
  </script>
</AccountLayout>
