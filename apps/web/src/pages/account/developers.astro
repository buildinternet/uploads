---
import { env } from "cloudflare:workers";
import AccountLayout from "../../layouts/AccountLayout.astro";
import { renderDetailListPlaceholderHtml } from "../../lib/workspace-ui";
import { resolveShowConsoleLinks } from "../../lib/signed-in-page";

export const prerender = false;

const showConsoleLinks = await resolveShowConsoleLinks(env);
---

<AccountLayout section="developers">
  <!--
    CLI setup card. Script toggles status from list-sessions + sticky
    user.cliOnboardedAt. Deep link: /account/developers#cli-setup.
  -->
  <section class="card is-pending" id="cli-setup" data-setup="checking">
    <h2>Set up the CLI</h2>
    <p class="settings-note">
      Install once, then <code>uploads login</code> and
      <code>uploads put</code> / <code>uploads attach</code>.
    </p>
    <div id="cli-setup-status" class="ul-callout" data-state="muted" role="status">
      Checking for a CLI sign-in…
    </div>
    <div id="cli-upgrade" class="ul-callout cli-upgrade" hidden role="status">
      <span class="ul-callout__title">CLI update</span>
      <p id="cli-upgrade-msg" class="cli-upgrade__msg"></p>
      <div class="cli-upgrade__actions">
        <div class="command">
          <code id="cli-upgrade-cmd"></code>
          <button type="button" id="cli-upgrade-copy" data-copy="" aria-live="polite">copy</button>
        </div>
        <button type="button" class="text-btn" id="cli-upgrade-dismiss">Dismiss</button>
      </div>
    </div>
    <div class="cli-steps" id="cli-steps">
      <div class="command" id="cli-install-cmd">
        <code>npm install -g @buildinternet/uploads</code>
        <button type="button" data-copy="npm install -g @buildinternet/uploads" aria-live="polite"
          >copy</button
        >
      </div>
      <div class="command">
        <code>uploads login</code>
        <button type="button" data-copy="uploads login" aria-live="polite">copy</button>
      </div>
    </div>
    <p class="muted cli-note" id="cli-setup-note">
      Or <code>npx @buildinternet/uploads login</code> —
      <a href="/docs#install">docs</a>.
    </p>
    <div id="cli-agents">
      <p class="muted cli-note">Agents (skill + MCP for Claude Code):</p>
      <div class="cli-steps cli-steps--solo">
        <div class="command">
          <code>uploads install</code>
          <button type="button" data-copy="uploads install" aria-live="polite">copy</button>
        </div>
      </div>
    </div>
  </section>

  <section class="card settings-page" id="api-keys">
    <div class="settings-section">
      <h2>API keys</h2>
      <p class="settings-note muted">
        For curl, CI, and scripts. The CLI uses your only workspace automatically; if you have
        several, pass <code>--workspace</code>.
      </p>

      <form class="ws-form" id="api-key-form">
        <div class="input-group">
          <label class="input-group__field">
            <span class="sr-only">Key name</span>
            <input
              name="name"
              required
              maxlength="32"
              minlength="1"
              placeholder="ci, local, agent…"
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <button type="submit" class="input-group__action" id="api-key-create">Create</button>
        </div>
      </form>

      <div class="ul-callout" id="api-key-created" role="status" hidden>
        <p><strong>Copy this key now.</strong> It will not be shown again.</p>
        <div class="command">
          <code id="api-key-secret"></code>
          <button type="button" id="api-key-secret-copy" data-copy="" aria-live="polite"
            >copy</button
          >
        </div>
        <div class="command">
          <code id="api-key-exports"></code>
          <button type="button" id="api-key-exports-copy" data-copy="" aria-live="polite"
            >copy</button
          >
        </div>
      </div>
      <p class="muted cli-note" id="api-key-error" role="alert" hidden></p>

      <div id="api-key-status" class="muted detail-status" hidden></div>
      <ul
        class="detail-list"
        id="api-key-list"
        aria-busy="true"
        set:html={renderDetailListPlaceholderHtml()}
      />
    </div>
  </section>

  <section class="card settings-page dev-page">
    <div class="settings-section">
      <h2>Developers</h2>
      <p class="settings-note muted">API and CI. Day to day starts with the CLI setup above.</p>
      <ul class="dev-links">
        {
          showConsoleLinks ? (
            <li>
              <a href="/console">Console</a>
              <span class="slug">token-based ops</span>
            </li>
          ) : null
        }
        <li>
          <a href="/docs">API docs</a>
          <span class="slug">endpoints &amp; auth</span>
        </li>
        <li>
          <a href="https://github.com/buildinternet/uploads">GitHub</a>
          <span class="slug">source &amp; issues</span>
        </li>
      </ul>
    </div>
  </section>

  <style>
    .cli-upgrade {
      margin: 10px 0 0;
    }
    .cli-upgrade__msg {
      margin: 0 0 10px;
    }
    .cli-upgrade__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 14px;
    }
    .cli-upgrade .command {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0;
    }
    #api-key-created {
      margin: 12px 0 0;
    }
    #api-key-created .command {
      margin: 8px 0 0;
    }
    #api-key-exports {
      white-space: pre-wrap;
    }
  </style>

  <script>
    import { onAstroPageLoad, onSession, requireElement } from "../../lib/account-shell";
    import { listSessions, type AuthSession } from "../../lib/auth-client";
    import {
      bestCliVersion,
      dismissUpgrade,
      isUpgradeDismissed,
      resolveUpgradePrompt,
    } from "../../lib/cli-upgrade";
    import { resolveCliSetupState } from "../../lib/cli-setup-state";

    onAstroPageLoad(() => {
      if (!document.getElementById("cli-setup")) return;

      const authOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
        .__UPLOADS_AUTH_ORIGIN__;

      requireElement<HTMLElement>("#cli-setup", "developers").addEventListener("click", (event) => {
        void (async () => {
          const dismiss = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "#cli-upgrade-dismiss",
          );
          if (dismiss) {
            const box = requireElement<HTMLElement>("#cli-upgrade", "developers");
            const latest = box.dataset.latest;
            if (latest) dismissUpgrade(latest, sessionStorage);
            box.hidden = true;
            return;
          }
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
            "button[data-copy], #cli-upgrade-copy",
          );
          if (!button) return;
          const text = button.dataset.copy ?? "";
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const previous = button.textContent;
            button.textContent = "copied ✓";
            setTimeout(() => {
              button.textContent = previous;
            }, 1500);
          } catch {
            // Clipboard blocked — leave the label.
          }
        })();
      });

      async function maybeShowCliUpgrade(sessions: AuthSession[] | null): Promise<void> {
        const box = requireElement<HTMLElement>("#cli-upgrade", "developers");
        box.hidden = true;
        if (!sessions?.length) return;

        const current = bestCliVersion(sessions);
        if (!current) return;

        let latest: string | undefined;
        try {
          const res = await fetch("/cli-version.json", { credentials: "same-origin" });
          if (!res.ok) return;
          const body = (await res.json()) as { latest?: unknown };
          if (typeof body.latest === "string") latest = body.latest;
        } catch {
          return;
        }

        const prompt = resolveUpgradePrompt(current, latest);
        if (!prompt || isUpgradeDismissed(prompt.latest, sessionStorage)) return;

        requireElement<HTMLElement>("#cli-upgrade-msg", "developers").textContent = prompt.message;
        requireElement<HTMLElement>("#cli-upgrade-cmd", "developers").textContent =
          prompt.installCmd;
        requireElement<HTMLButtonElement>("#cli-upgrade-copy", "developers").dataset.copy =
          prompt.installCmd;
        box.dataset.latest = prompt.latest;
        box.hidden = false;
      }

      function applyCliSetup(
        sessions: Awaited<ReturnType<typeof listSessions>>,
        cliOnboardedAt: string | Date | null | undefined,
        loaded: boolean,
      ): void {
        const { kind, statusText, statusState } = resolveCliSetupState({
          sessions,
          cliOnboardedAt,
          loaded,
        });
        const status = requireElement<HTMLElement>("#cli-setup-status", "developers");
        const card = requireElement<HTMLElement>("#cli-setup", "developers");
        const steps = requireElement<HTMLElement>("#cli-steps", "developers");
        const installCmd = requireElement<HTMLElement>("#cli-install-cmd", "developers");
        const note = requireElement<HTMLElement>("#cli-setup-note", "developers");

        card.dataset.setup = kind;
        card.classList.toggle("is-pending", kind === "checking" || kind === "setup");
        if (statusState) status.dataset.state = statusState;
        else delete status.dataset.state;
        status.textContent = statusText;

        // ready: hide commands; reconnect: login only; setup/checking: full install.
        steps.hidden = kind === "ready";
        installCmd.hidden = kind === "reconnect";
        note.hidden = kind === "ready" || kind === "reconnect";

        if (loaded) void maybeShowCliUpgrade(sessions);
      }

      onSession((user) => {
        applyCliSetup(null, user.cliOnboardedAt, false);
        void listSessions(authOrigin).then((sessions) => {
          applyCliSetup(sessions, user.cliOnboardedAt, true);
        });
      });
    });
  </script>

  <script>
    import { onAstroPageLoad, onSession, requireElement } from "../../lib/account-shell";
    import {
      createApiKey,
      deleteApiKey,
      listApiKeys,
      listOrganizations,
      type DeveloperApiKey,
    } from "../../lib/auth-client";
    import { escapeHtml } from "../../lib/workspace-ui";

    function formatApiKeyWhen(value: string | Date | null | undefined): string {
      if (!value) return "";
      const date = value instanceof Date ? value : new Date(value);
      if (!Number.isFinite(date.getTime())) return "";
      return date.toISOString().slice(0, 10);
    }

    onAstroPageLoad(() => {
      if (!document.getElementById("api-keys")) return;

      const authOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
        .__UPLOADS_AUTH_ORIGIN__;

      let workspaces: string[] = [];

      function renderKeys(keys: DeveloperApiKey[] | null): void {
        const list = requireElement<HTMLUListElement>("#api-key-list", "developers");
        const status = requireElement<HTMLElement>("#api-key-status", "developers");
        list.setAttribute("aria-busy", keys === null ? "true" : "false");
        if (keys === null) {
          status.hidden = false;
          status.textContent = "Couldn’t load API keys.";
          list.replaceChildren();
          return;
        }
        status.hidden = true;
        if (keys.length === 0) {
          list.innerHTML = `<li><div class="detail-main"><div class="detail-title">No keys yet</div><div class="detail-meta">Create one above to start.</div></div></li>`;
          return;
        }
        list.innerHTML = keys
          .map((key) => {
            const title = escapeHtml(key.name || "Untitled");
            const start = key.start ? escapeHtml(key.start) : "key";
            const created = formatApiKeyWhen(key.createdAt);
            const used = formatApiKeyWhen(key.lastRequest);
            const meta = [
              start,
              created ? `created ${created}` : "",
              used ? `last used ${used}` : "never used",
            ]
              .filter(Boolean)
              .join(" · ");
            return `<li data-key-id="${escapeHtml(key.id)}"><div class="detail-main"><div class="detail-title">${title}</div><div class="detail-meta">${meta}</div></div><button type="button" class="text-btn" data-revoke="${escapeHtml(key.id)}">Revoke</button></li>`;
          })
          .join("");
      }

      function exportSnippet(token: string): string {
        const workspace = workspaces.length === 1 ? workspaces[0] : "<workspace>";
        return `export UPLOADS_TOKEN=${token}\nexport UPLOADS_WORKSPACE=${workspace}`;
      }

      async function refreshKeys(): Promise<void> {
        renderKeys(await listApiKeys(authOrigin));
      }

      requireElement<HTMLFormElement>("#api-key-form", "developers").addEventListener(
        "submit",
        (event) => {
          event.preventDefault();
          const form = event.currentTarget as HTMLFormElement;
          const input = form.elements.namedItem("name");
          const name = input instanceof HTMLInputElement ? input.value.trim() : "";
          if (!name) return;
          const button = requireElement<HTMLButtonElement>("#api-key-create", "developers");
          const error = requireElement<HTMLElement>("#api-key-error", "developers");
          const created = requireElement<HTMLElement>("#api-key-created", "developers");
          button.disabled = true;
          error.hidden = true;
          void createApiKey(authOrigin, name).then((result) => {
            button.disabled = false;
            if (!result.ok) {
              error.hidden = false;
              error.textContent = result.message;
              return;
            }
            if (input instanceof HTMLInputElement) input.value = "";
            const secret = requireElement<HTMLElement>("#api-key-secret", "developers");
            const secretCopy = requireElement<HTMLButtonElement>(
              "#api-key-secret-copy",
              "developers",
            );
            const exportsEl = requireElement<HTMLElement>("#api-key-exports", "developers");
            const exportsCopy = requireElement<HTMLButtonElement>(
              "#api-key-exports-copy",
              "developers",
            );
            secret.textContent = result.key;
            secretCopy.dataset.copy = result.key;
            const snippet = exportSnippet(result.key);
            exportsEl.textContent = snippet;
            exportsCopy.dataset.copy = snippet;
            created.hidden = false;
            void refreshKeys();
          });
        },
      );

      requireElement<HTMLElement>("#api-keys", "developers").addEventListener("click", (event) => {
        void (async () => {
          const target = event.target as HTMLElement;
          const copy = target.closest<HTMLButtonElement>("button[data-copy]");
          if (copy) {
            const text = copy.dataset.copy ?? "";
            if (!text) return;
            try {
              await navigator.clipboard.writeText(text);
              const previous = copy.textContent;
              copy.textContent = "copied ✓";
              setTimeout(() => {
                copy.textContent = previous;
              }, 1500);
            } catch {
              // Clipboard blocked — leave the label.
            }
            return;
          }
          const revoke = target.closest<HTMLButtonElement>("[data-revoke]");
          if (!revoke) return;
          const id = revoke.dataset.revoke;
          if (!id) return;
          revoke.disabled = true;
          const ok = await deleteApiKey(authOrigin, id);
          if (!ok) {
            const error = requireElement<HTMLElement>("#api-key-error", "developers");
            error.hidden = false;
            error.textContent = "Could not revoke that key.";
            revoke.disabled = false;
            return;
          }
          requireElement<HTMLElement>("#api-key-created", "developers").hidden = true;
          await refreshKeys();
        })();
      });

      onSession(() => {
        void listOrganizations(authOrigin).then((orgs) => {
          workspaces = (orgs ?? []).map((org) => org.slug).filter(Boolean);
        });
        void refreshKeys();
      });
    });
  </script>
</AccountLayout>
