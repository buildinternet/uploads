---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AdminWorkspacesTable } from "../../components/admin/AdminWorkspacesTable";
import { resolveSignedInOrigins } from "../../lib/signed-in-page";

export const prerender = false;

const { apiOrigin } = resolveSignedInOrigins();

// Carries the same apiOrigin into the client mount script below (plain
// `<script>`, not `client:*` — SSR-first island, same mechanism as
// WorkspaceFileTable). No user data in the seed, but `<`-escaped for parity
// with the other island seeds.
const seedJson = JSON.stringify({ apiOrigin }).replace(/</g, "\\u003c");
---

<AdminLayout section="workspaces">
  <section class="admin-page grid gap-4 min-w-0">
    <header class="admin-page-header grid gap-1.5 max-w-2xl">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">Workspaces</h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Every registered workspace, with its plan and storage mode at a glance. Select a row to open
        people, plan, limits, storage, and invites.
      </p>
    </header>
    <div id="admin-workspaces-mount">
      <AdminWorkspacesTable apiOrigin={apiOrigin} />
    </div>
  </section>

  <script type="application/json" id="admin-workspaces-seed" set:html={seedJson} />

  <script>
    import { onAstroPageLoad } from "../../lib/account-shell";
    import { createIslandMounter } from "../../lib/react-island";
    import type { AdminWorkspacesTableProps } from "../../components/admin/AdminWorkspacesTable";

    const boot = createIslandMounter<AdminWorkspacesTableProps>({
      mountId: "admin-workspaces-mount",
      seedId: "admin-workspaces-seed",
      load: () =>
        import("../../components/admin/AdminWorkspacesTable").then((m) => m.AdminWorkspacesTable),
    });

    onAstroPageLoad(() => void boot());
  </script>
</AdminLayout>
