---
/**
 * Operator transactional email previews. POST /admin-ui/dev/emails/:type.
 * Type list mirrors EMAIL_PREVIEW_TYPES in apps/api/src/admin-email-preview.ts.
 * Below them, the operator-run outdated CLI campaign:
 * POST /admin-ui/campaigns/cli-upgrade (apps/api/src/cli-upgrade-campaign.ts).
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  ADMIN_BTN,
  ADMIN_CELL_MUTED,
  ADMIN_CELL_PRIMARY,
  ADMIN_TD,
  ADMIN_TD_ACTIONS,
  ADMIN_TH,
  ADMIN_TH_ACTIONS,
} from "../../lib/admin-ui";

export const prerender = false;

// Keep in sync with apps/api/src/admin-email-preview.ts EMAIL_PREVIEW_TYPES.
const PREVIEW_TYPES = [
  { id: "magic-link", label: "Magic sign-in link", category: "Auth" },
  { id: "org-invitation", label: "Workspace invitation", category: "Auth" },
  { id: "member-joined", label: "Member joined notify", category: "Auth" },
  { id: "member-join-admin-notice", label: "Admin: member joined notify", category: "Auth" },
  { id: "usage-limit-alert", label: "Admin: usage limit alert", category: "Auth" },
  { id: "welcome", label: "Welcome / next steps", category: "Auth" },
  { id: "enrollment-invitation", label: "Enrollment invitation", category: "Invites" },
  { id: "cli-upgrade", label: "Outdated CLI campaign", category: "Product updates" },
] as const;
---

<AdminLayout section="email">
  <section class="admin-page grid gap-4 min-w-0">
    <header class="admin-page-header grid gap-1.5 max-w-2xl">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">Email previews</h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Send a sample of each product email through Cloudflare Email Sending. Links use placeholder
        tokens and will not complete a real sign-in or invite. Defaults to your signed-in address;
        override for another inbox (e.g. Gmail markup tests).
      </p>
    </header>

    <div class="admin-field flex flex-wrap items-center gap-y-2 gap-x-3 max-w-[480px]">
      <label
        for="email-to"
        class="grid gap-1 text-muted-foreground text-(length:--text-micro) uppercase tracking-[0.06em]"
        >Send to</label
      >
      <input
        type="email"
        id="email-to"
        maxlength="320"
        placeholder="you@example.com"
        class="flex-1 min-w-[200px] bg-panel border border-border rounded-sm text-foreground px-[9px] py-[7px] text-(length:--text-micro) focus-visible:outline-none focus-visible:border-primary"
      />
    </div>

    <div
      id="email-action-status"
      class="admin-status text-(length:--text-meta) text-muted-foreground"
      role="status"
      hidden
    >
    </div>

    <div class="admin-table-wrap w-full overflow-x-auto">
      <table
        class="admin-table w-full border-collapse text-(length:--text-meta) leading-[1.4]"
        aria-label="Email previews"
      >
        <thead>
          <tr>
            <th class={`keep ${ADMIN_TH}`} scope="col">Template</th>
            <th class={ADMIN_TH} scope="col">Category</th>
            <th class={`actions ${ADMIN_TH_ACTIONS}`} scope="col"></th>
          </tr>
        </thead>
        <tbody>
          {
            PREVIEW_TYPES.map((t) => (
              <tr class="admin-row">
                <td class={`keep ${ADMIN_TD}`}>
                  <span class={`primary ${ADMIN_CELL_PRIMARY}`}>{t.label}</span>
                </td>
                <td class={`optional ${ADMIN_TD} ${ADMIN_CELL_MUTED}`}>{t.category}</td>
                <td class={`actions ${ADMIN_TD_ACTIONS}`}>
                  <button
                    type="button"
                    class={`admin-btn email-send ${ADMIN_BTN}`}
                    data-type={t.id}
                  >
                    Send preview
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <header class="admin-page-header grid gap-1.5 max-w-2xl mt-4">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">
        Outdated CLI campaign
      </h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Emails people whose newest CLI in the last 30 days is below a version, if they left product
        updates on. Count first. Each send covers up to 100 people, and nobody gets the same
        campaign twice.
      </p>
    </header>

    <form
      id="campaign-form"
      class="admin-field flex flex-wrap items-end gap-y-2 gap-x-3 max-w-[480px]"
    >
      <label
        for="campaign-version"
        class="grid gap-1 text-muted-foreground text-(length:--text-micro) uppercase tracking-[0.06em]"
        >Below version</label
      >
      <input
        type="text"
        id="campaign-version"
        required
        pattern="\d+\.\d+\.\d+"
        placeholder="0.59.0"
        class="w-[120px] bg-panel border border-border rounded-sm text-foreground px-[9px] py-[7px] text-(length:--text-micro) focus-visible:outline-none focus-visible:border-primary"
      />
      <button type="submit" id="campaign-count" class={`admin-btn ${ADMIN_BTN}`}>Count</button>
      <button type="button" id="campaign-send" class={`admin-btn ${ADMIN_BTN}`} disabled>
        Send
      </button>
    </form>

    <div
      id="campaign-status"
      class="admin-status text-(length:--text-meta) text-muted-foreground"
      role="status"
      hidden
    >
    </div>
    <ul
      id="campaign-sample"
      class="m-0 pl-5 text-(length:--text-micro) text-muted-foreground grid gap-0.5"
      hidden
    >
    </ul>
  </section>

  <script>
    import { onAstroPageLoad, onSession, requireElement } from "../../lib/account-shell";

    onAstroPageLoad(() => {
      if (!document.getElementById("email-to")) return;

      const w = window as unknown as { __UPLOADS_API_ORIGIN__: string };
      const apiOrigin = w.__UPLOADS_API_ORIGIN__.replace(/\/$/, "");
      const toInput = requireElement<HTMLInputElement>("#email-to", "admin email");
      const statusEl = requireElement<HTMLElement>("#email-action-status", "admin email");
      const buttons = [...document.querySelectorAll<HTMLButtonElement>("button.email-send")];

      let busy = false;

      function setStatus(message: string, state?: "ready" | "error") {
        statusEl.hidden = !message;
        statusEl.textContent = message;
        if (state) statusEl.dataset.state = state;
        else delete statusEl.dataset.state;
      }

      function setBusy(typeId: string | null) {
        busy = typeId != null;
        for (const btn of buttons) {
          btn.disabled = busy;
          btn.textContent = btn.dataset.type === typeId ? "Sending…" : "Send preview";
        }
      }

      async function sendPreview(typeId: string) {
        if (!typeId || busy) return;
        setBusy(typeId);
        setStatus("");
        try {
          const to = toInput.value.trim();
          const res = await fetch(
            `${apiOrigin}/admin-ui/dev/emails/${encodeURIComponent(typeId)}`,
            {
              method: "POST",
              credentials: "include",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(to ? { to } : {}),
            },
          );
          const payload = (await res.json().catch(() => null)) as {
            ok?: boolean;
            to?: string;
            subject?: string;
            error?: { message?: string };
          } | null;

          if (!res.ok || !payload?.ok || !payload.to) {
            setStatus(
              payload?.error?.message ||
                (res.status === 503
                  ? "Email Sending is not configured on this environment."
                  : `Could not send (${res.status}).`),
              "error",
            );
            return;
          }
          setStatus(`Sent "${payload.subject ?? typeId}" to ${payload.to}`, "ready");
        } catch {
          setStatus("Could not send the preview email.", "error");
        } finally {
          setBusy(null);
        }
      }

      onSession((user) => {
        if (user?.email && !toInput.value) toInput.value = user.email;
      });

      for (const btn of buttons) {
        btn.addEventListener("click", () => void sendPreview(btn.dataset.type ?? ""));
      }

      const campaignForm = requireElement<HTMLFormElement>("#campaign-form", "admin email");
      const versionInput = requireElement<HTMLInputElement>("#campaign-version", "admin email");
      const countBtn = requireElement<HTMLButtonElement>("#campaign-count", "admin email");
      const sendBtn = requireElement<HTMLButtonElement>("#campaign-send", "admin email");
      const campaignStatus = requireElement<HTMLElement>("#campaign-status", "admin email");
      const sampleList = requireElement<HTMLUListElement>("#campaign-sample", "admin email");

      type CampaignResult = {
        eligible?: number;
        sample?: { email: string; version: string | null }[];
        sent?: number;
        failed?: number;
        error?: { message?: string };
      };

      function setCampaignStatus(message: string, state?: "ready" | "error") {
        campaignStatus.hidden = !message;
        campaignStatus.textContent = message;
        if (state) campaignStatus.dataset.state = state;
        else delete campaignStatus.dataset.state;
      }

      let counted = { version: "", eligible: 0 };

      async function runCampaign(send: boolean) {
        const minimumVersion = versionInput.value.trim();
        countBtn.disabled = true;
        sendBtn.disabled = true;
        try {
          const res = await fetch(`${apiOrigin}/admin-ui/campaigns/cli-upgrade`, {
            method: "POST",
            credentials: "include",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ minimumVersion, send }),
          });
          const payload = (await res.json().catch(() => null)) as CampaignResult | null;
          if (!res.ok || typeof payload?.eligible !== "number") {
            setCampaignStatus(payload?.error?.message || `Could not run (${res.status}).`, "error");
            counted = { version: "", eligible: 0 };
            return;
          }
          counted = { version: minimumVersion, eligible: payload.eligible };
          const left = `${payload.eligible} ${payload.eligible === 1 ? "person" : "people"} below ${minimumVersion} not emailed yet.`;
          setCampaignStatus(
            send ? `Sent ${payload.sent ?? 0}, ${payload.failed ?? 0} failed. ${left}` : left,
            send && payload.failed ? "error" : "ready",
          );
          sampleList.replaceChildren(
            ...(payload.sample ?? []).map((r) => {
              const li = document.createElement("li");
              li.textContent = `${r.email} (${r.version ?? "older than 0.57.0"})`;
              return li;
            }),
          );
          sampleList.hidden = send || !payload.sample?.length;
        } catch {
          setCampaignStatus("Could not reach the API.", "error");
        } finally {
          countBtn.disabled = false;
          sendBtn.disabled = !(
            counted.eligible > 0 && counted.version === versionInput.value.trim()
          );
        }
      }

      campaignForm.addEventListener("submit", (event) => {
        event.preventDefault();
        void runCampaign(false);
      });
      versionInput.addEventListener("input", () => {
        sendBtn.disabled = true;
      });
      sendBtn.addEventListener("click", () => {
        const batch = Math.min(counted.eligible, 100);
        if (
          !window.confirm(
            `Email ${batch} ${batch === 1 ? "person" : "people"} to update to ${counted.version}?`,
          )
        ) {
          return;
        }
        void runCampaign(true);
      });
    });
  </script>
</AdminLayout>
