---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AdminModels } from "../../components/admin/AdminModels";
import { resolveSignedInOrigins } from "../../lib/signed-in-page";

export const prerender = false;

const { apiOrigin } = resolveSignedInOrigins();
const seedJson = JSON.stringify({ apiOrigin }).replace(/</g, "\\u003c");
---

<AdminLayout section="models">
  <section class="admin-page grid gap-4 min-w-0">
    <header class="admin-page-header grid gap-1.5 max-w-2xl">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">Models</h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Which model each AI feature runs. A change applies to the next call, with no deploy.
      </p>
    </header>
    <div id="admin-models-mount">
      <AdminModels apiOrigin={apiOrigin} />
    </div>
  </section>

  <script type="application/json" id="admin-models-seed" set:html={seedJson} />

  <script>
    import { onAstroPageLoad } from "../../lib/account-shell";
    import { createIslandMounter } from "../../lib/react-island";
    import type { AdminModelsProps } from "../../components/admin/AdminModels";

    const boot = createIslandMounter<AdminModelsProps>({
      mountId: "admin-models-mount",
      seedId: "admin-models-seed",
      load: () => import("../../components/admin/AdminModels").then((m) => m.AdminModels),
    });

    onAstroPageLoad(() => void boot());
  </script>
</AdminLayout>
