---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AdminBlocks } from "../../components/admin/AdminBlocks";
import { resolveSignedInOrigins } from "../../lib/signed-in-page";

export const prerender = false;

const { apiOrigin } = resolveSignedInOrigins();
const seedJson = JSON.stringify({ apiOrigin }).replace(/</g, "\\u003c");
---

<AdminLayout section="blocks">
  <section class="admin-page grid gap-4 min-w-0">
    <header class="admin-page-header grid gap-1.5 max-w-2xl">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">Blocked URLs</h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Take down one hosted file for abuse or a legal request. A blocked image shows the "Held for
        review" card and any other file returns 404, within about a minute. The file is not deleted
        and nothing else in the workspace changes.
      </p>
    </header>
    <div id="admin-blocks-mount">
      <AdminBlocks apiOrigin={apiOrigin} />
    </div>
  </section>

  <script type="application/json" id="admin-blocks-seed" set:html={seedJson} />

  <script>
    import { onAstroPageLoad } from "../../lib/account-shell";
    import { createIslandMounter } from "../../lib/react-island";
    import type { AdminBlocksProps } from "../../components/admin/AdminBlocks";

    const boot = createIslandMounter<AdminBlocksProps>({
      mountId: "admin-blocks-mount",
      seedId: "admin-blocks-seed",
      load: () => import("../../components/admin/AdminBlocks").then((m) => m.AdminBlocks),
    });

    onAstroPageLoad(() => void boot());
  </script>
</AdminLayout>
