---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { AdminClassifier } from "../../components/admin/AdminClassifier";
import { resolveSignedInOrigins } from "../../lib/signed-in-page";

export const prerender = false;

const { apiOrigin } = resolveSignedInOrigins();
const seedJson = JSON.stringify({ apiOrigin }).replace(/</g, "\\u003c");
---

<AdminLayout section="classifier">
  <section class="admin-page grid gap-4 min-w-0">
    <header class="admin-page-header grid gap-1.5 max-w-2xl">
      <h2 class="m-0 text-(length:--text-body) font-semibold text-foreground">Classifier</h2>
      <p class="m-0 text-body text-(length:--text-meta) leading-[1.55] text-pretty">
        Classifier coverage, errors, and safety flags. A missing safety answer means the file was
        not classified, not that it is clean.
      </p>
    </header>
    <div id="admin-classifier-mount">
      <AdminClassifier apiOrigin={apiOrigin} />
    </div>
  </section>

  <script type="application/json" id="admin-classifier-seed" set:html={seedJson} />

  <script>
    import { onAstroPageLoad } from "../../lib/account-shell";
    import { createIslandMounter } from "../../lib/react-island";
    import type { AdminClassifierProps } from "../../components/admin/AdminClassifier";

    const boot = createIslandMounter<AdminClassifierProps>({
      mountId: "admin-classifier-mount",
      seedId: "admin-classifier-seed",
      load: () => import("../../components/admin/AdminClassifier").then((m) => m.AdminClassifier),
    });

    onAstroPageLoad(() => void boot());
  </script>
</AdminLayout>
