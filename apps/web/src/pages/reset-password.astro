---
import { SAME_ORIGIN_AUTH_BASE } from "../lib/auth-client";
import { applyAuthSecurityHeaders, authPageCsp } from "../lib/signed-in-page";
import BaseHead from "../components/BaseHead.astro";
import Brand from "../components/Brand.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;

const authOrigin = SAME_ORIGIN_AUTH_BASE;

// Header (not meta): frame-ancestors is ignored on meta CSP.
applyAuthSecurityHeaders(Astro.response.headers, authPageCsp(authOrigin));
---

<html lang="en">
  <head>
    <BaseHead />
    <meta name="referrer" content="no-referrer" />
    <title>Set password · uploads.sh</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 28px;
        background: var(--bg);
        color: var(--fg);
        font: var(--text-body) / var(--leading-body) var(--sans);
        letter-spacing: var(--tracking-body);
      }
      main {
        width: min(var(--width-card, 480px), 100%);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: clamp(24px, 6vw, 40px);
      }
      .brandbar {
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
      }
      h1 {
        margin: 0 0 8px;
        font-size: var(--text-h2);
        font-weight: var(--weight-semibold);
        letter-spacing: -0.015em;
        line-height: 1.25;
      }
      p {
        color: var(--body);
        margin: 0 0 20px;
      }
      .status {
        margin: 16px 0;
      }
      /* The page's one primary action — solid accent (mirrors .ul-btn--solid). */
      button.github {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font: var(--weight-medium) var(--text-ui) / 1 var(--sans);
        letter-spacing: var(--tracking-ui);
        color: var(--bg);
        background: var(--accent);
        border: 1px solid var(--accent);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        cursor: pointer;
      }
      button.github:hover,
      button.github:focus-visible {
        background: color-mix(in srgb, var(--accent) 88%, #fff);
        border-color: color-mix(in srgb, var(--accent) 88%, #fff);
        outline: none;
      }
      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      form {
        display: grid;
        gap: 10px;
      }
      label {
        display: grid;
        gap: 6px;
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      input {
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        color: var(--fg);
        padding: 10px 12px;
        font: var(--text-ui) var(--sans);
      }
      input:focus-visible {
        border-color: var(--accent);
        outline: none;
      }
      button[type="submit"] {
        font: var(--text-micro) var(--sans);
        letter-spacing: 0.04em;
        color: var(--accent);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        cursor: pointer;
      }
      button[type="submit"]:hover,
      button[type="submit"]:focus-visible {
        border-color: var(--accent);
        outline: none;
      }
      button:disabled {
        opacity: 0.6;
        cursor: default;
      }
      /* Password sign-in stays a quiet fallback below the main options. */
      .alt-link {
        background: none;
        border: 0;
        padding: 0;
        color: var(--muted);
        font: var(--text-micro) var(--sans);
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
        text-underline-offset: 3px;
        cursor: pointer;
      }
      .alt-link:hover,
      .alt-link:focus-visible {
        color: var(--fg);
        outline: none;
      }
      .alt-row {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 14px;
      }
      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <ThemeToggle floating />
    <main>
      <div class="brandbar"><Brand /></div>
      <h1>Set a password</h1>
      <p>A backup to GitHub and email links. Saving it signs you out everywhere.</p>

      <div id="done-state" hidden>
        <div class="ul-callout status" data-state="ready" role="status">
          Password saved. <a href="/login">Sign in</a>
        </div>
      </div>

      <form id="reset-form">
        <label>
          New password
          <input
            id="new-password"
            type="password"
            required
            minlength="12"
            maxlength="128"
            autocomplete="new-password"
          />
        </label>
        <button type="submit" id="reset-submit">Save password</button>
      </form>
      <div class="ul-callout status" id="error" data-state="error" role="alert" hidden></div>

      <Footer compact />
    </main>
    <script define:vars={{ authOrigin }}>
      window.__UPLOADS_AUTH_ORIGIN__ = authOrigin;
    </script>
    <script>
      import { resetPassword } from "../lib/auth-client";

      const authOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
        .__UPLOADS_AUTH_ORIGIN__;

      function requireElement<T extends Element>(selector: string): T {
        const element = document.querySelector<T>(selector);
        if (!element) throw new Error(`reset-password page is missing ${selector}`);
        return element as T;
      }

      const form = requireElement<HTMLFormElement>("#reset-form");
      const submit = requireElement<HTMLButtonElement>("#reset-submit");
      const input = requireElement<HTMLInputElement>("#new-password");
      const errorBox = requireElement<HTMLElement>("#error");
      const doneState = requireElement<HTMLElement>("#done-state");

      // Better Auth redirects here with ?token= (or ?error=INVALID_TOKEN).
      // Drop it from the address bar so it doesn't linger in history.
      const params = new URLSearchParams(location.search);
      const token = params.get("token");
      history.replaceState(null, "", location.pathname);

      function showError(message: string): void {
        errorBox.innerHTML = `${message} <a href="/login">Request a new link</a>`;
        errorBox.hidden = false;
      }

      if (!token) {
        form.hidden = true;
        showError("This link is invalid or has expired.");
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!token) return;
        errorBox.hidden = true;
        submit.disabled = true;
        try {
          const result = await resetPassword(authOrigin, token, input.value);
          if (result.ok) {
            form.hidden = true;
            doneState.hidden = false;
            return;
          }
          if (result.code === "PASSWORD_TOO_SHORT" || result.code === "PASSWORD_TOO_LONG") {
            errorBox.textContent = "Use 12 to 128 characters.";
            errorBox.hidden = false;
          } else {
            form.hidden = true;
            showError("This link is invalid or has expired.");
          }
        } catch {
          errorBox.textContent = "Couldn't save the password. Try again.";
          errorBox.hidden = false;
        }
        submit.disabled = false;
      });
    </script>
  </body>
</html>
