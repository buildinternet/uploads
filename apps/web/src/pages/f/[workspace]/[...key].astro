---
import { serverTimingDisabled, type TimingEnv } from "@uploads/observability";
import BaseHead from "../../../components/BaseHead.astro";
import Brand from "../../../components/Brand.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import FileActions from "../../../components/FileActions.astro";
import FileDetails from "../../../components/FileDetails.astro";
import Footer from "../../../components/Footer.astro";
import MediaStage from "../../../components/MediaStage.astro";
import ReportAbuse from "../../../components/ReportAbuse.astro";
import UnfurlMeta from "../../../components/UnfurlMeta.astro";
import { GH_KIND_PATH } from "../../../lib/brand-icons";
import {
  comparisonRows,
  ownBeforeAfterState,
  type BeforeAfterState,
} from "../../../lib/before-after-view";
import { buildEmbedFormats } from "../../../lib/embed-formats";
import {
  applyPublicFileHeaders,
  publicFileCsp,
  fetchPublicFile,
  fetchTextPreview,
  fileDownloadUrl,
  fileKind as kind,
  filePath,
  isTextPreviewable,
} from "../../../lib/public-file";
import { oembedDiscoveryHref } from "../../../lib/oembed";
import { env } from "cloudflare:workers";
import { publicApiFetch } from "../../../lib/ssr-fetch";
import { resolveSignedInOrigins } from "../../../lib/signed-in-page";
import { workspaceHomePath } from "../../../lib/workspaces-nav";

export const prerender = false;

const ssrStarted = Date.now();
const timingsEnabled = !serverTimingDisabled(env as TimingEnv);
const workspace = Astro.params.workspace ?? "";
const key = Astro.params.key ?? "";
// SSR-only, absolute — fetchPublicFile validates this is a real https:/loopback
// origin and fetches it directly (server-to-server, no browser cookie jar
// involved), so it stays independent of the browser-facing same-origin value
// below (#731 phase D).
const origin =
  env.UPLOADS_API_ORIGIN ?? import.meta.env.PUBLIC_UPLOADS_API_ORIGIN ?? "https://api.uploads.sh";
const fetchStarted = Date.now();
const result = await fetchPublicFile(workspace, key, {
  origin,
  fetch: publicApiFetch(env),
  transport: env.API ? "binding" : "http",
  onServerTiming: timingsEnabled
    ? (value) => Astro.response.headers.append("Server-Timing", value)
    : undefined,
});
if (timingsEnabled)
  Astro.response.headers.append("Server-Timing", `file_ssr_fetch;dur=${Date.now() - fetchStarted}`);

// Browser-facing: the delete/file-url probe below and ReportAbuse's fetch are
// credentialed(-ish) calls a real visitor's browser makes, so they go through
// the same-origin /api proxy rather than api.uploads.sh directly (#731 phase D).
const { apiOrigin: browserApiOrigin } = resolveSignedInOrigins();

applyPublicFileHeaders(Astro.response.headers, { csp: publicFileCsp(browserApiOrigin) });

const file = result.status === "ok" ? result.file : null;
if (result.status === "unavailable") Astro.response.status = 503;
else if (result.status === "auth_required") Astro.response.status = 401;
else if (!file) Astro.response.status = 404;

const previewUrl = file?.previewUrl ?? file?.url ?? null;
const filename = key.split("/").filter(Boolean).pop() ?? key;
const gh = file?.github;
const ghKindLabel = gh?.kind === "pull" ? "Pull request" : gh ? "Issue" : "";
const ghRef = gh ? `${gh.repo}#${gh.number}` : "";
const ghAriaLabel = gh
  ? gh.title
    ? `${ghKindLabel} ${gh.title} (${ghRef}) on GitHub`
    : `${ghKindLabel} ${ghRef} on GitHub`
  : "";
const canonical = new URL(file ? filePath(workspace, key) : Astro.url.pathname, Astro.url.origin)
  .href;
// Empty when there's no file.
const embedFormats = file
  ? buildEmbedFormats({
      canonical,
      url: file.url,
      embedUrl: file.embedUrl,
      filename,
      kind: kind(file.contentType),
    })
  : [];
const downloadUrl = file ? fileDownloadUrl(origin, workspace, key) : null;
// Inline text preview (issue #946): SSR-fetch the object body from storage
// (server-to-server, no CORS concern) for small text/markdown/csv/json
// files; any failure/timeout/oversized body falls back to the file card.
const textStarted = Date.now();
const textPreview =
  file && isTextPreviewable(file.contentType, file.size)
    ? await fetchTextPreview(previewUrl!, { timeoutMs: 5000 })
    : null;
if (timingsEnabled && file && isTextPreviewable(file.contentType, file.size))
  Astro.response.headers.append(
    "Server-Timing",
    `file_text_preview;dur=${Date.now() - textStarted}`,
  );
const title = file
  ? `${filename} · uploads.sh`
  : result.status === "auth_required"
    ? "Sign in to view · uploads.sh"
    : "File unavailable · uploads.sh";
// oEmbed discovery only when the public object is fully resolved — private /
// missing pages must not advertise an endpoint that would 404 or leak existence.
const oembedHref = file ? oembedDiscoveryHref(canonical, Astro.url.origin) : null;

// Before/after paired view (issue #420). The API already did the
// visibility-safe lookup (routes/public-files.ts); this page only decides
// how to lay the two images out. Own state comes from `state` metadata when
// present, else it's simply the counterpart's opposite — either way, only
// rendered when the API actually returned a counterpart.
const counterpart = file?.counterpart ?? null;

const ownState: BeforeAfterState | null = counterpart
  ? ownBeforeAfterState(file?.metadata?.state, counterpart.state)
  : null;
const counterpartHref = counterpart ? filePath(workspace, counterpart.key) : null;
const railRows = ownState && counterpartHref ? comparisonRows(ownState, counterpartHref) : null;
// Belt and braces: the API only pairs images (isPairableImageContentType on both
// sides, apps/api/src/routes/public-files.ts), so this never actually filters.
const compare =
  counterpart && ownState && kind(file!.contentType) === "image"
    ? { src: counterpart.previewUrl ?? counterpart.url, ownState }
    : null;
const mediaKind = file ? kind(file.contentType) : null;
const aiLabelsSettingsHref = `/account/workspaces/${encodeURIComponent(workspace)}/settings/ai-labels`;
const unfurlKind = mediaKind === "image" || mediaKind === "video" ? mediaKind : "other";
if (timingsEnabled)
  Astro.response.headers.append("Server-Timing", `file_ssr_prepare;dur=${Date.now() - ssrStarted}`);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content="Public file hosted by uploads.sh." />
    <UnfurlMeta
      pageUrl={canonical}
      siteOrigin={Astro.url.origin}
      title={file ? filename : "File unavailable"}
      description="Public file hosted by uploads.sh."
      kind={unfurlKind}
      mediaUrl={previewUrl}
      contentType={file?.contentType ?? null}
      posterUrl={file?.posterUrl ?? null}
      width={file?.videoDimensions?.width ?? null}
      height={file?.videoDimensions?.height ?? null}
    />
    {
      oembedHref && (
        <link
          rel="alternate"
          type="application/json+oembed"
          href={oembedHref}
          title={`${filename} oEmbed Profile`}
        />
      )
    }
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--fg);
        background: var(--bg);
        font-family: var(--sans);
        display: flex;
        flex-direction: column;
      }
      .shell {
        width: min(var(--width-viewer, 1080px), calc(100% - 48px));
        margin: 0 auto;
        padding: 36px 0 64px;
        flex: 1 0 auto;
        box-sizing: border-box;
      }
      nav.top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        font: var(--text-meta) var(--mono);
        letter-spacing: 0.02em;
      }
      .nav-end {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      .public {
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px 11px;
        background: var(--panel);
      }
      /* Click-to-copy share pill — replaces the static "public file" label whenever there's a link to copy. */
      /* Title on the left, FileActions on the right; actions wrap under on narrow screens. */
      .filehead {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px 24px;
        margin: 0 0 16px;
        min-width: 0;
      }
      .filehead-text {
        flex: 1 1 320px;
        min-width: 0;
      }
      .filetitle {
        margin: 0;
        color: var(--fg);
        font: 600 var(--text-h3) var(--mono);
        letter-spacing: -0.01em;
        overflow-wrap: anywhere;
      }
      /* PR/issue under the filename — light byline, not a rail chip. */
      .gh-byline {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        column-gap: 8px;
        row-gap: 2px;
        margin-top: 6px;
        max-width: 100%;
        color: var(--muted);
        font: var(--text-meta)/1.45 var(--sans);
        text-decoration: none;
      }
      .gh-byline:hover,
      .gh-byline:focus-visible {
        color: var(--accent);
        outline: none;
      }
      .gh-byline-avatar {
        flex: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--panel);
        border: 1px solid var(--line);
      }
      .gh-byline-icon {
        flex: none;
        align-self: center;
      }
      .gh-byline-title {
        color: var(--body);
        overflow-wrap: anywhere;
      }
      .gh-byline:hover .gh-byline-title,
      .gh-byline:focus-visible .gh-byline-title {
        color: inherit;
      }
      .gh-byline-sep {
        opacity: 0.7;
      }
      .gh-byline-ref {
        overflow-wrap: anywhere;
      }
      /* Right rail content (slotted into MediaStage): Details uses label + rule. */
      .rail-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 12px;
      }
      .rail-label {
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .rail-rule {
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      /* Before/after counterpart (issue #420) — rail rows; the stage itself
         carries the comparison via ImagePreview's Compare mode. */
      .pairlist {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font: var(--text-micro) var(--mono);
      }
      .pairrow {
        display: flex;
        align-items: baseline;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
      }
      .pairrow a {
        color: var(--body);
        text-decoration: none;
      }
      .pairrow a:hover,
      .pairrow a:focus-visible {
        color: var(--accent);
        outline: none;
      }
      .pairrow[data-current="true"] {
        color: var(--accent);
      }
      .pairrow-note {
        color: var(--muted);
        text-transform: none;
        letter-spacing: normal;
        font-size: var(--text-micro);
      }
      .error {
        padding: 70px 24px;
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        text-align: center;
        background: var(--panel);
        color: var(--body);
      }
      .error code {
        color: var(--accent);
        font-family: var(--mono);
      }
      .error .signin {
        display: inline-block;
        margin-top: 18px;
        padding: 9px 16px;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--bg);
        color: var(--fg);
        font: var(--text-micro) var(--sans);
        text-decoration: none;
      }
      .error .signin:hover,
      .error .signin:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
        outline: none;
      }
      .error button.signin {
        margin-left: 8px;
        cursor: pointer;
      }
      .error button.signin:disabled {
        opacity: 0.6;
        cursor: default;
      }
      /* Held file (upload-hold.ts): the normal file layout under an amber
         banner. Members only; the script reveals it. */
      .held {
        --held: #e8a93a;
        --held-ink: #f3d9a4;
        --held-strong: #fbe7bd;
        --held-bg: #1f180b;
        --held-line: #5a431a;
        --held-on: #1a1405;
      }
      :global(html[data-theme="light"]) .held {
        --held: #9a6412;
        --held-ink: #5c3d0a;
        --held-strong: #3d2905;
        --held-bg: #fbf0d9;
        --held-line: #e2c48a;
        --held-on: #ffffff;
      }
      .held-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 16px;
        margin: 0 0 20px;
        padding: 14px 16px 14px 18px;
        border: 1px solid var(--held-line);
        border-radius: var(--radius-lg);
        background: var(--held-bg);
        color: var(--held-ink);
      }
      .held-banner svg {
        flex: none;
        color: var(--held);
      }
      .held-banner-text {
        flex: 1 1 320px;
        min-width: 0;
      }
      .held-banner h2 {
        margin: 0 0 3px;
        color: var(--held-strong);
        font: 600 var(--text-ui) / 1.4 var(--sans);
      }
      .held-banner p {
        margin: 0;
        font: var(--text-meta) / 1.45 var(--sans);
      }
      .held-banner a {
        color: inherit;
        text-decoration-color: currentColor;
      }
      .held-approve {
        flex: none;
        padding: 9px 16px;
        border: 1px solid var(--held);
        border-radius: var(--radius-md);
        background: var(--held);
        color: var(--held-on);
        font: 600 var(--text-meta) var(--sans);
        cursor: pointer;
      }
      .held-approve:focus-visible {
        outline: 2px solid var(--held-strong);
        outline-offset: 2px;
      }
      .held-approve:disabled {
        opacity: 0.6;
        cursor: default;
      }
      .held-error {
        flex-basis: 100%;
        margin: 0;
        color: var(--red);
        font: var(--text-micro) var(--sans);
      }
      .held-sub {
        margin: 6px 0 0;
        color: var(--muted);
        font: var(--text-meta) var(--sans);
      }
      .held-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 38px;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--panel);
        color: var(--fg);
      }
      .held-download:hover,
      .held-download:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
        outline: none;
      }
      .held-stage {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      .held-media {
        min-height: 320px;
        display: grid;
        place-items: center;
        padding: 24px;
        background: var(--bg);
      }
      .held-media figure {
        margin: 0;
      }
      .held-frame {
        position: relative;
        display: inline-block;
        max-width: 100%;
      }
      .held-frame img {
        display: block;
        max-width: 100%;
        max-height: 70vh;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
      }
      .held-area {
        position: absolute;
        border: 2px solid var(--held);
        border-radius: var(--radius-md);
        background: color-mix(in srgb, var(--held) 12%, transparent);
        pointer-events: none;
      }
      .held-nopreview {
        margin: 0;
        color: var(--muted);
        font: var(--text-meta) var(--sans);
        text-align: center;
      }
      .held-rail {
        display: flex;
        flex-direction: column;
        gap: 22px;
        padding: 18px 20px 22px;
        border-top: 1px solid var(--line);
      }
      .held-meta {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 6px 16px;
        margin: 0;
        font: var(--text-micro) / 1.5 var(--sans);
      }
      .held-meta dt {
        color: var(--muted);
      }
      .held-meta dd {
        margin: 0;
        color: var(--body);
      }
      .held-foot {
        margin: auto 0 0;
        color: var(--muted);
        font: var(--text-micro) / 1.5 var(--sans);
      }
      @media (min-width: 1080px) {
        .held-stage {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
        }
        .held-rail {
          border-top: none;
          border-left: 1px solid var(--line);
        }
      }
      /* Members-only note on a file that was held and approved. */
      .reviewed-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        font: var(--text-micro) / 1.5 var(--sans);
      }
      .reviewed-row svg {
        flex: none;
        margin-top: 2px;
        color: var(--green);
      }
      .reviewed-row strong {
        display: block;
        color: var(--fg);
        font-weight: 500;
      }
      .reviewed-row span {
        color: var(--body);
      }
      .reviewed-team {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 10px 0 0;
        color: var(--muted);
        font: var(--text-micro) var(--sans);
      }
      .error .checking {
        display: block;
        margin-top: 14px;
        color: var(--muted);
        font: var(--text-micro) var(--sans);
      }
      /* The display rules above beat the UA's [hidden] rule. Keep hidden
         status lines, links, and buttons hidden until the script shows them. */
      [hidden] {
        display: none !important;
      }
      a {
        color: var(--fg);
        text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
        text-underline-offset: 3px;
      }
      @media (min-width: 1080px) {
        /* align with signed-in --bp-rail (1080px); media queries can't read custom props */
        .shell {
          width: min(1200px, calc(100% - 48px));
        }
      }
      @media (max-width: 760px) {
        .shell {
          width: min(100% - 32px, 1080px);
          padding-top: 24px;
        }
      }
      /* Report + Delete dialogs, opened from the header's ⋯ menu. */
      dialog.sheet {
        width: min(380px, calc(100vw - 32px));
        box-sizing: border-box;
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        background: var(--panel);
        color: var(--fg);
        font-family: var(--sans);
      }
      dialog.sheet::backdrop {
        background: rgb(0 0 0 / 0.55);
      }
      .delete-title {
        margin: 0 0 8px;
        font: 600 var(--text-ui) var(--sans);
      }
      .delete-text {
        margin: 0 0 10px;
        color: var(--body);
        font-size: var(--text-meta);
        line-height: 1.5;
        overflow-wrap: anywhere;
      }
      .delete-gh,
      .delete-error {
        color: var(--muted);
        font-size: var(--text-micro);
      }
      .delete-error {
        color: var(--red);
      }
      .delete-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
      }
      .delete-actions button {
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--bg);
        color: var(--fg);
        font: var(--text-meta) var(--sans);
        cursor: pointer;
      }
      .delete-actions .delete-confirm {
        border-color: var(--red);
        background: var(--red);
        color: var(--bg);
      }
      .delete-actions button:disabled {
        opacity: 0.6;
        cursor: default;
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <nav class="top">
        <Brand />
        <div class="nav-end">
          <ThemeToggle />
          {!file && result.status !== "auth_required" && <span class="public">public file</span>}
        </div>
      </nav>
      {
        file ? (
          <>
            <header class="filehead">
              <div class="filehead-text">
                <h1 class="filetitle">{filename}</h1>
                {gh && (
                  <a
                    class="gh-byline"
                    href={gh.url}
                    rel="noopener noreferrer"
                    aria-label={ghAriaLabel}
                  >
                    {gh.avatarUrl && (
                      <img
                        class="gh-byline-avatar"
                        src={gh.avatarUrl}
                        alt=""
                        width="16"
                        height="16"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <svg
                      class="gh-byline-icon"
                      viewBox="0 0 16 16"
                      width="13"
                      height="13"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <title>{gh.kind === "pull" ? "pull request" : "issue"}</title>
                      <path fill="currentColor" d={GH_KIND_PATH[gh.kind]} />
                    </svg>
                    {gh.title ? (
                      <>
                        <span class="gh-byline-title">{gh.title}</span>
                        <span class="gh-byline-sep" aria-hidden="true">
                          ·
                        </span>
                        <span class="gh-byline-ref">{ghRef}</span>
                      </>
                    ) : (
                      <span class="gh-byline-ref">{ghRef}</span>
                    )}
                  </a>
                )}
              </div>
              <FileActions
                formats={embedFormats}
                canonical={canonical}
                downloadUrl={downloadUrl}
                originalUrl={file.url}
              >
                <div class="fa-sep" />
                <button type="button" class="fa-item" id="report-open">
                  Report a problem
                </button>
                <button type="button" class="fa-item" id="hold-again" hidden>
                  Hold for review again
                </button>
                <button type="button" class="fa-item fa-item--danger" id="delete-open" hidden>
                  Delete file…
                </button>
              </FileActions>
            </header>
            <MediaStage
              kind={kind(file.contentType)}
              url={previewUrl}
              filename={filename}
              posterUrl={file.posterUrl}
              videoDimensions={file.videoDimensions}
              compare={compare}
              contentType={file.contentType}
              size={file.size}
              downloadUrl={downloadUrl}
              textPreview={textPreview}
            >
              {railRows && (
                <div>
                  <div class="rail-head">
                    <span class="rail-label">Comparison</span>
                    <span class="rail-rule" aria-hidden="true" />
                  </div>
                  <ul class="pairlist">
                    {railRows.map((row) => (
                      <li class="pairrow" data-current={row.current ? "true" : "false"}>
                        {row.href ? (
                          <a href={row.href} aria-label={`View the ${row.state} image`}>
                            {row.state} ↗
                          </a>
                        ) : (
                          <>
                            <span>{row.state}</span>
                            <span class="pairrow-note">this file</span>
                          </>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <div id="reviewed" hidden>
                <div class="rail-head">
                  <span class="rail-label">Reviewed</span>
                  <span class="rail-rule" aria-hidden="true" />
                </div>
                <div class="reviewed-row">
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path
                      d="M8 1.5l5.5 2v4c0 3.3-2.4 6-5.5 7-3.1-1-5.5-3.7-5.5-7v-4z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M5.5 8l1.8 1.8L10.5 6.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <div>
                    <strong id="reviewed-reason">Flagged for possible sensitive information</strong>
                    <span id="reviewed-by">Approved</span>
                  </div>
                </div>
                <p class="reviewed-team">
                  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                    <rect
                      x="3.5"
                      y="7"
                      width="9"
                      height="6.5"
                      rx="1.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                    <path
                      d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                    />
                  </svg>
                  Only visible to your team
                </p>
              </div>
              <FileDetails
                metadata={file.metadata}
                size={file.size}
                uploaded={file.uploaded}
                modified={file.modified}
              />
            </MediaStage>
            <dialog class="sheet" id="report-dialog" aria-label="Report a problem">
              <ReportAbuse
                apiOrigin={browserApiOrigin}
                pageUrl={canonical}
                workspace={workspace}
                objectKey={key}
              />
            </dialog>
            <dialog class="sheet" id="delete-pop" aria-label={`Delete ${filename}`}>
              <h2 class="delete-title">Delete this file?</h2>
              <p class="delete-text">
                Permanently delete <strong>{filename}</strong> for everyone? Links and embeds will
                break.
              </p>
              {gh && (
                <p class="delete-text delete-gh">
                  This file is attached to {ghRef}. The managed comment will keep a broken link
                  until its next sync.
                </p>
              )}
              <p class="delete-text delete-error" id="delete-error" hidden />
              <div class="delete-actions">
                <button type="button" id="delete-cancel">
                  Cancel
                </button>
                <button type="button" class="delete-confirm" id="delete-step">
                  Delete file
                </button>
              </div>
            </dialog>
            <section class="error" id="deleted-state" hidden>
              <code>file.deleted</code>
              <h1>File deleted</h1>
              <p>This file has been permanently removed.</p>
              <a class="signin" href={workspaceHomePath(workspace)}>
                Workspace
              </a>
            </section>
          </>
        ) : result.status === "auth_required" ? (
          <>
            <section class="error" id="auth-required">
              <code>file.auth_required</code>
              <h1>This file is unlisted</h1>
              <p>Sign in to view this page if you're a member of this workspace.</p>
              <a class="signin" id="signin-link" href="/login">
                Sign in
              </a>
              <span class="checking" id="auth-checking" hidden>
                Checking your session…
              </span>
            </section>
            <div class="held" id="held-state" hidden>
              <section class="held-banner" aria-labelledby="held-title">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M10 2.5l8 14H2z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M10 8v4M10 14.2v.3"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                </svg>
                <div class="held-banner-text">
                  <h2 id="held-title">
                    Held for review because it may show{" "}
                    <span id="held-reason">sensitive information</span>
                  </h2>
                  <p>
                    Its link is paused until a workspace member approves it. Check the file first.
                    <span class="held-admin" hidden>
                      {" "}
                      <a href={aiLabelsSettingsHref}>Hold settings</a>
                    </span>
                  </p>
                </div>
                <button type="button" class="held-approve" id="held-approve">
                  Approve and publish
                </button>
                <p class="held-error" id="held-error" hidden>
                  Couldn't approve this file. Try again shortly.
                </p>
              </section>
              <header class="filehead">
                <div class="filehead-text">
                  <h1 class="filetitle">{filename}</h1>
                  <p class="held-sub">Not public yet</p>
                </div>
                <a
                  class="held-download"
                  id="held-download"
                  aria-label="Download to check"
                  title="Download to check"
                  hidden
                >
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path
                      d="M8 2v8M4.5 7L8 10.5 11.5 7M3 13.5h10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                </a>
              </header>
              <div class="held-stage">
                <div class="held-media">
                  <figure id="held-preview" hidden>
                    <div class="held-frame">
                      <img id="held-image" alt="The held file" />
                      <div class="held-area" id="held-area" hidden />
                    </div>
                  </figure>
                  <p class="held-nopreview" id="held-nopreview">
                    No preview for this file. Download it to check.
                  </p>
                </div>
                <aside class="held-rail">
                  <div>
                    <div class="rail-head">
                      <span class="rail-label">Hold</span>
                      <span class="rail-rule" aria-hidden="true" />
                    </div>
                    <dl class="held-meta">
                      <dt>Reason</dt>
                      <dd id="held-reason-row">Sensitive information</dd>
                      <dt id="held-where-label" hidden>
                        Where
                      </dt>
                      <dd id="held-where" hidden>
                        Outlined in the preview
                      </dd>
                      <dt>Link</dt>
                      <dd>Paused</dd>
                    </dl>
                  </div>
                  <p class="held-foot">
                    Holds come from AI labels.{" "}
                    <span class="held-member">
                      Workspace admins can turn them off in Settings → AI labels.
                    </span>
                    <span class="held-admin" hidden>
                      You can turn them off in{" "}
                      <a href={aiLabelsSettingsHref}>Settings → AI labels</a>.
                    </span>
                  </p>
                </aside>
              </div>
            </div>
          </>
        ) : (
          <section class="error">
            <>
              <code>{result.status === "unavailable" ? "file.unavailable" : "file.not_found"}</code>
              <h1>
                {result.status === "unavailable"
                  ? "File temporarily unavailable"
                  : "File not found"}
              </h1>
              <p>
                {result.status === "unavailable"
                  ? "The file service could not be reached. Please try again shortly."
                  : "This file may have been removed, or the link is incorrect."}
              </p>
            </>
          </section>
        )
      }
    </main>
    <Footer />
    <!--
      Top-level script (not JSX-conditional): prettier-plugin-astro cannot
      parse `define:vars` inside a JSX expression (issue #551). `authRequired`
      early-returns so public/ok pages stay inert.
    -->
    <script
      define:vars={{
        apiOrigin: browserApiOrigin,
        workspace,
        key,
        authRequired: result.status === "auth_required",
      }}
    >
      // Base `/v1/workspaces/:name/files` endpoint (apiOrigin/workspace come
      // in via define:vars above) shared by the three call sites below —
      // this inline script can't import api-client.ts's trimOrigin/URL
      // builders, so the one local helper stands in for it.
      function filesEndpoint(suffix) {
        return `${apiOrigin.replace(/\/$/, "")}/v1/workspaces/${encodeURIComponent(workspace)}/files${suffix}`;
      }

      // Progressive-enhancement, client-side authorization path — a second
      // gate parallel to the server-side one this page already applied via
      // fetchPublicFile()/objectVisibility (apps/api's GET /public/files/...,
      // see apps/api/src/routes/public-files.ts). Both this probe and the
      // /v1/workspaces/:name/files/file-url resolver it calls must keep enforcing
      // the same auth_required condition as that server gate, or a signed-out
      // viewer could see one page disagree with the other about access.
      (async function () {
        if (!authRequired) return;
        const checking = document.getElementById("auth-checking");
        // A held file answers like a private one. Show a member the hold,
        // with Approve, instead of redirecting to bytes that may be gone.
        if (await showHeld()) return;
        try {
          const endpoint = filesEndpoint(`/file-url?key=${encodeURIComponent(key)}`);
          if (checking) checking.hidden = false;
          const response = await fetch(endpoint, {
            credentials: "include",
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) {
            if (checking) checking.hidden = true;
            return;
          }
          const body = await response.json();
          if (body && typeof body.url === "string" && body.url.startsWith("https://")) {
            window.location.replace(body.url);
            return;
          }
        } catch (e) {
          // Network hiccup / signed-out — leave the sign-in state as-is.
        }
        if (checking) checking.hidden = true;
      })();

      async function showHeld() {
        try {
          const response = await fetch(filesEndpoint(`/held?prefix=${encodeURIComponent(key)}`), {
            credentials: "include",
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) return false;
          const body = await response.json();
          const item = (body?.items ?? []).find((entry) => entry.key === key);
          if (!item) return false;
          document.getElementById("auth-required").hidden = true;
          document.getElementById("held-state").hidden = false;
          document.title = "Held for review · uploads.sh";
          const reason =
            typeof item.reason === "string" && item.reason.startsWith("secret")
              ? ["a credential", "Credential"]
              : typeof item.reason === "string" && item.reason.startsWith("pii")
                ? ["personal information", "Personal information"]
                : null;
          if (reason) {
            document.getElementById("held-reason").textContent = reason[0];
            document.getElementById("held-reason-row").textContent = reason[1];
          }
          const download = document.getElementById("held-download");
          download.href = filesEndpoint(`/held/download?key=${encodeURIComponent(key)}`);
          // A legacy hold streams from the held bucket. A hosted hold that
          // never moved streams the public object from the same route, and
          // the preview unhides the download once those bytes load. A
          // bring-your-own bucket has neither, so the no-preview line stays.
          if (item.moved) download.hidden = false;
          else document.getElementById("held-nopreview").textContent = "No preview for this file.";
          void showHeldPreview(download.href, item.area);
          void showHoldSettingsLinks();
          const approve = document.getElementById("held-approve");
          const error = document.getElementById("held-error");
          approve.addEventListener("click", async function () {
            approve.disabled = true;
            error.hidden = true;
            try {
              const sha =
                typeof item.sha === "string" ? `&expected_sha=${encodeURIComponent(item.sha)}` : "";
              const result = await fetch(
                filesEndpoint(`/approve?key=${encodeURIComponent(key)}${sha}`),
                {
                  method: "POST",
                  credentials: "include",
                },
              );
              if (!result.ok) throw new Error(String(result.status));
              window.location.reload();
            } catch (e) {
              approve.disabled = false;
              error.hidden = false;
            }
          });
          return true;
        } catch (e) {
          return false;
        }
      }

      // Hold settings live on an admin-only page. The same settings read
      // that page makes answers only for admins and owners, so it decides
      // who gets links to it.
      async function showHoldSettingsLinks() {
        try {
          const response = await fetch(
            `${apiOrigin.replace(/\/$/, "")}/v1/workspaces/${encodeURIComponent(workspace)}/classifier-settings`,
            { credentials: "include", headers: { Accept: "application/json" }, cache: "no-store" },
          );
          if (!response.ok) return;
          for (const el of document.querySelectorAll(".held-admin")) el.hidden = false;
          for (const el of document.querySelectorAll(".held-member")) el.hidden = true;
        } catch (e) {
          // Members keep the plain note.
        }
      }

      // An image hold shows the held copy, with the flagged area outlined
      // when the classifier located it. Anything that isn't an image stays
      // download-only.
      async function showHeldPreview(href, area) {
        try {
          const response = await fetch(href, { credentials: "include", cache: "no-store" });
          if (!response.ok) return;
          document.getElementById("held-download").hidden = false;
          const blob = await response.blob();
          if (!blob.type.startsWith("image/") || blob.type === "image/svg+xml") return;
          const image = document.getElementById("held-image");
          image.src = URL.createObjectURL(blob);
          document.getElementById("held-preview").hidden = false;
          document.getElementById("held-nopreview").hidden = true;
          if (!area) return;
          const box = document.getElementById("held-area");
          box.style.top = `${area.top * 100}%`;
          box.style.left = `${area.left * 100}%`;
          box.style.width = `${(area.right - area.left) * 100}%`;
          box.style.height = `${(area.bottom - area.top) * 100}%`;
          box.hidden = false;
          document.getElementById("held-where-label").hidden = false;
          document.getElementById("held-where").hidden = false;
        } catch (e) {
          // The download link still works.
        }
      }

      // Report a problem: the ⋯ menu item opens the report dialog.
      (function () {
        const openBtn = document.getElementById("report-open");
        const dialog = document.getElementById("report-dialog");
        if (!openBtn || !(dialog instanceof HTMLDialogElement)) return;
        openBtn.addEventListener("click", function () {
          dialog.showModal();
        });
      })();

      // Members-only Reviewed note for a file that was held and approved,
      // plus "Hold for review again" in the ⋯ menu for an approval made by
      // mistake. The public API strips the hold rows, so this asks the
      // members-only review endpoint.
      async function showReviewed() {
        try {
          const response = await fetch(filesEndpoint(`/review?key=${encodeURIComponent(key)}`), {
            credentials: "include",
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) return;
          const review = await response.json();
          if (review?.hold !== "approved") return;
          const reason = typeof review.reason === "string" ? review.reason : "";
          document.getElementById("reviewed-reason").textContent = reason.startsWith("secret")
            ? "Flagged for a possible credential"
            : reason.startsWith("pii")
              ? "Flagged for possible personal information"
              : "Flagged for possible sensitive information";
          const when = review.at ? new Date(review.at) : null;
          const date =
            when && !Number.isNaN(when.getTime())
              ? when.toLocaleDateString(undefined, {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })
              : null;
          const by = typeof review.by === "string" && review.by ? ` by ${review.by}` : "";
          document.getElementById("reviewed-by").textContent =
            `Approved${by}` + (date ? ` · ${date}` : "");
          document.getElementById("reviewed").hidden = false;

          const holdBtn = document.getElementById("hold-again");
          holdBtn.hidden = false;
          holdBtn.addEventListener("click", async function () {
            const ok = window.confirm(
              "Hold this file for review again? Its link stops working until someone approves it. If it shows a credential, rotate the credential too: the file was public.",
            );
            if (!ok) return;
            holdBtn.disabled = true;
            try {
              const sha =
                typeof review.sha === "string"
                  ? `&expected_sha=${encodeURIComponent(review.sha)}`
                  : "";
              const result = await fetch(
                filesEndpoint(`/hold?key=${encodeURIComponent(key)}${sha}`),
                {
                  method: "POST",
                  credentials: "include",
                },
              );
              if (!result.ok) throw new Error(String(result.status));
              window.location.reload();
            } catch (e) {
              holdBtn.disabled = false;
              window.alert("Couldn't hold this file. Try again shortly.");
            }
          });
        } catch (e) {
          // Leave the page as the public sees it.
        }
      }

      // Member-only delete control (spec 2026-07-30). Reveal is progressive
      // enhancement: the same /v1/workspaces/:name/files/file-url probe the unlisted
      // flow uses doubles as the membership check — 200 means member.
      (async function () {
        const openBtn = document.getElementById("delete-open");
        const pop = document.getElementById("delete-pop");
        if (!openBtn || !(pop instanceof HTMLDialogElement)) return;
        const endpoint = filesEndpoint(`/file-url?key=${encodeURIComponent(key)}`);
        try {
          const probe = await fetch(endpoint, {
            credentials: "include",
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!probe.ok) return;
        } catch (e) {
          return;
        }
        openBtn.hidden = false;
        void showReviewed();

        const stepBtn = document.getElementById("delete-step");
        const cancelBtn = document.getElementById("delete-cancel");
        const errorEl = document.getElementById("delete-error");

        // Once a DELETE is in flight, Cancel/Escape must not close the dialog
        // or re-enable the button — a re-click would fire a second request.
        var deleteInFlight = false;

        // The modal dialog is the confirmation step, so Delete deletes.
        openBtn.addEventListener("click", function () {
          errorEl.hidden = true;
          pop.showModal();
          cancelBtn.focus();
        });
        cancelBtn.addEventListener("click", function () {
          if (!deleteInFlight) pop.close();
        });
        pop.addEventListener("cancel", function (event) {
          if (deleteInFlight) event.preventDefault();
        });

        stepBtn.addEventListener("click", async function () {
          deleteInFlight = true;
          stepBtn.disabled = true;
          cancelBtn.disabled = true;
          try {
            // Canonical path-keyed dual-auth delete (session cookie or bearer).
            // Twin of deleteWorkspaceFile() in src/lib/api-client.ts — this
            // public/no-framework page can't import the helper, so keep the two
            // in sync. The old query-param form (?key=) matched no /v1 route and
            // fell through to the bearer-only guard, 401ing session users.
            const keyPath = key.split("/").map(encodeURIComponent).join("/");
            const target = filesEndpoint(`/${keyPath}`);
            const response = await fetch(target, { method: "DELETE", credentials: "include" });
            if (!response.ok) throw new Error(String(response.status));
            // Swap the page to the deleted state.
            pop.close();
            const figure = document.querySelector("[data-media-stage]");
            const head = document.querySelector(".filehead");
            if (figure) figure.remove();
            if (head) head.remove();
            const done = document.getElementById("deleted-state");
            if (done) done.hidden = false;
          } catch (e) {
            deleteInFlight = false;
            errorEl.textContent = "Couldn't delete this file. Try again shortly.";
            errorEl.hidden = false;
            stepBtn.disabled = false;
            cancelBtn.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
