---
import BaseHead from "../../components/BaseHead.astro";
import Brand from "../../components/Brand.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Footer from "../../components/Footer.astro";
import GalleryReferences from "../../components/GalleryReferences.astro";
import MediaFallback from "../../components/MediaFallback.astro";
import UnfurlMeta from "../../components/UnfurlMeta.astro";
import { mediaPreviewFailedBody, MEDIA_PREVIEW_FAILED_TITLE } from "../../lib/media-load";
import {
  applyPublicGalleryHeaders,
  fetchPublicGallery,
  galleryItemDownloadUrl,
  galleryItemPath,
  galleryPath,
  mediaKind as kind,
  type PublicGalleryItem,
} from "../../lib/public-gallery";
import { oembedDiscoveryHref } from "../../lib/oembed";
import { collectionPreview } from "../../lib/unfurl";
import { env } from "cloudflare:workers";
import { publicApiFetch } from "../../lib/ssr-fetch";

export const prerender = false;

const id = Astro.params.id ?? "";
const origin =
  env.UPLOADS_API_ORIGIN ?? import.meta.env.PUBLIC_UPLOADS_API_ORIGIN ?? "https://api.uploads.sh";
const result = await fetchPublicGallery(id, { origin, fetch: publicApiFetch(env) });

applyPublicGalleryHeaders(Astro.response.headers);
if (result.status === "not_found") Astro.response.status = 404;
if (result.status === "unavailable") Astro.response.status = 503;

const gallery = result.status === "ok" ? result.gallery : null;
const canonical = new URL(galleryPath(id), Astro.url.origin).href;
const itemPage = (item: PublicGalleryItem) => galleryItemPath(id, item.id);
const summary = gallery
  ? `${gallery.items.length} ${gallery.items.length === 1 ? "item" : "items"}, updated ${new Date(
      gallery.updatedAt,
    ).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}.`
  : "";
const oembedHref = gallery ? oembedDiscoveryHref(canonical, Astro.url.origin) : null;
const description = gallery?.description ?? "A public media gallery hosted by uploads.sh.";
const preview = gallery
  ? collectionPreview(
      gallery.items.map((item) => ({
        id: item.id,
        kind: kind(item),
        url: item.url,
        posterUrl: item.posterUrl,
      })),
      gallery.coverItemId,
    )
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <title>{gallery ? `${gallery.title} · uploads.sh` : "Gallery unavailable · uploads.sh"}</title>
    <meta name="description" content={description} />
    <UnfurlMeta
      pageUrl={canonical}
      siteOrigin={Astro.url.origin}
      title={gallery?.title ?? "Gallery unavailable"}
      description={description}
      kind={preview?.source === "image" ? "image" : "other"}
      mediaUrl={preview?.source === "image" ? preview.url : null}
      posterUrl={preview?.source === "poster" ? preview.url : null}
    />
    {
      oembedHref && gallery && (
        <link
          rel="alternate"
          type="application/json+oembed"
          href={oembedHref}
          title={`${gallery.title} oEmbed Profile`}
        />
      )
    }
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--fg);
        background: var(--bg);
        font-family: var(--sans);
        display: flex;
        flex-direction: column;
      }
      .shell {
        width: min(var(--width-viewer, 1080px), calc(100% - 48px));
        margin: 0 auto;
        padding: 36px 0 64px;
        flex: 1 0 auto;
        box-sizing: border-box;
      }
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        font: var(--text-meta) var(--sans);
        letter-spacing: 0.02em;
      }
      .nav-end {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      .public {
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 6px 11px;
        background: var(--panel);
      }
      header {
        max-width: 720px;
        margin-bottom: 28px;
      }
      .eyebrow {
        color: var(--muted);
        font: var(--text-micro) var(--sans);
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      h1 {
        margin: 10px 0 12px;
        font-size: var(--text-h1);
        font-weight: var(--weight-semibold);
        line-height: 1.2;
        letter-spacing: -0.015em;
        overflow-wrap: anywhere;
      }
      .desc {
        max-width: 640px;
        color: var(--body);
        font-size: var(--text-body);
        line-height: 1.65;
        white-space: pre-wrap;
      }
      .notice {
        margin: 22px 2px;
        color: var(--muted);
        font: var(--text-meta)/1.6 var(--sans);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 14px;
      }
      figure {
        grid-column: span 6;
        margin: 0;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        overflow: hidden;
      }
      .media {
        min-height: 260px;
        aspect-ratio: 16/10;
        background: var(--bg);
        display: grid;
        place-items: center;
        overflow: hidden;
      }
      img,
      video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
      .media[data-failed="1"] img,
      .media[data-failed="1"] video,
      .media[data-failed="1"] .media-link {
        display: none;
      }
      figcaption {
        padding: 14px 16px 16px;
        border-top: 1px solid var(--line);
      }
      .titlerow {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .filename {
        min-width: 0;
        color: var(--fg);
        font: var(--weight-semibold) var(--text-meta) / 1.3 var(--mono);
        text-decoration: none;
        overflow-wrap: anywhere;
      }
      .filename:hover,
      .filename:focus-visible {
        color: var(--accent);
      }
      .icons {
        display: flex;
        gap: 6px;
        flex: none;
      }
      .icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        background: var(--panel);
        color: var(--fg);
      }
      .icon-btn svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
      }
      .icon-btn:hover,
      .icon-btn:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
        outline: none;
      }
      .media-link {
        display: contents;
      }
      .caption {
        margin-top: 8px;
        color: var(--body);
        font-size: var(--text-ui);
        line-height: 1.5;
        white-space: pre-wrap;
      }
      .empty,
      .error {
        padding: 70px 24px;
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        text-align: center;
        background: var(--panel);
        color: var(--body);
      }
      .empty code,
      .error code {
        color: var(--accent);
        font-family: var(--mono);
      }
      a {
        color: var(--fg);
        text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
        text-underline-offset: 3px;
      }
      @media (max-width: 760px) {
        .shell {
          width: min(100% - 32px, 1080px);
          padding-top: 24px;
        }
        nav {
          margin-bottom: 32px;
        }
        figure {
          grid-column: 1/-1;
        }
        .media {
          min-height: 190px;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <nav>
        <Brand />
        <div class="nav-end">
          <ThemeToggle />
          <span class="public">public gallery</span>
        </div>
      </nav>
      {
        gallery ? (
          <>
            <header>
              <div class="eyebrow">Media collection</div>
              <h1>{gallery.title}</h1>
              {gallery.description && <div class="desc">{gallery.description}</div>}
            </header>
            <aside class="notice">
              {summary} Anyone with this link can view and enumerate this gallery. Do not share
              sensitive media.
            </aside>
            {gallery.items.length === 0 ? (
              <section class="empty">
                <code>gallery.empty</code>
                <p>This gallery is ready, but no media has been added yet.</p>
              </section>
            ) : (
              <section class="grid">
                {gallery.items.map((item) => {
                  const mediaKind = kind(item);
                  const pdfPoster = mediaKind === "file" && item.posterUrl ? item.posterUrl : null;
                  const previewable =
                    mediaKind === "image" || mediaKind === "video" || pdfPoster !== null;
                  return (
                    <figure>
                      <div class="media" data-media-load={previewable ? "" : undefined}>
                        {mediaKind === "image" && (
                          <a
                            class="media-link"
                            href={itemPage(item)}
                            aria-label={`View ${item.filename}`}
                          >
                            <img
                              src={item.url!}
                              alt={item.altText ?? item.caption ?? item.filename}
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        )}
                        {mediaKind === "video" && (
                          <video
                            src={item.url!}
                            poster={item.posterUrl ?? undefined}
                            controls
                            playsinline
                            preload={item.posterUrl ? "none" : "metadata"}
                            aria-describedby={`caption-${item.id}`}
                          >
                            Your browser cannot play this video.
                          </video>
                        )}
                        {previewable && (
                          <MediaFallback
                            pending
                            compact
                            title={MEDIA_PREVIEW_FAILED_TITLE}
                            body={mediaPreviewFailedBody(mediaKind === "video" ? "video" : "image")}
                            href={item.url}
                          />
                        )}
                        {pdfPoster && (
                          <a
                            class="media-link"
                            href={itemPage(item)}
                            aria-label={`View ${item.filename}`}
                          >
                            <img
                              src={pdfPoster}
                              alt={`First page of ${item.filename}`}
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        )}
                        {mediaKind === "file" && !pdfPoster && (
                          <MediaFallback
                            compact
                            title="Preview unavailable"
                            href={item.url}
                            filename={item.filename}
                          />
                        )}
                        {mediaKind === "missing" && (
                          <MediaFallback
                            compact
                            title="Removed or expired"
                            body="This item remains in the gallery to preserve its place."
                          />
                        )}
                      </div>
                      <figcaption id={`caption-${item.id}`}>
                        <div class="titlerow">
                          <a class="filename" href={itemPage(item)}>
                            {item.filename}
                          </a>
                          {item.status === "available" && (
                            <span class="icons">
                              <a
                                class="icon-btn"
                                href={item.url!}
                                rel="noopener noreferrer"
                                aria-label={`Open original of ${item.filename}`}
                                title="Open original"
                              >
                                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                  <path d="M9 3h4v4M13 3L7.5 8.5M11.5 9.5V13H3V4.5h3.5" />
                                </svg>
                              </a>
                              <a
                                class="icon-btn"
                                href={galleryItemDownloadUrl(origin, id, item.id)}
                                rel="noopener noreferrer"
                                aria-label={`Download ${item.filename}`}
                                title="Download"
                              >
                                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                                  <path d="M8 2v8M4.5 6.5L8 10l3.5-3.5M3 13h10" />
                                </svg>
                              </a>
                            </span>
                          )}
                        </div>
                        {item.caption && <div class="caption">{item.caption}</div>}
                      </figcaption>
                    </figure>
                  );
                })}
              </section>
            )}
            <GalleryReferences references={gallery.references} />
          </>
        ) : (
          <section class="error">
            <>
              <code>
                {result.status === "not_found" ? "gallery.not_found" : "gallery.unavailable"}
              </code>
              <h1>
                {result.status === "not_found"
                  ? "Gallery not found"
                  : "Gallery temporarily unavailable"}
              </h1>
              <p>
                {result.status === "not_found"
                  ? "Check the link or ask the gallery owner for a current URL."
                  : "The gallery service could not be reached. Please try again shortly."}
              </p>
            </>
          </section>
        )
      }
    </main>
    <Footer />
    <script>
      import { bindMediaFallbacks } from "../../lib/media-load";
      function boot(): void {
        bindMediaFallbacks(document);
      }
      boot();
      document.addEventListener("astro:page-load", boot);
    </script>
  </body>
</html>
