---
import PublicItemLayout from "../../../layouts/PublicItemLayout.astro";
import CopyAsControls from "../../../components/CopyAsControls.astro";
import GalleryReferences from "../../../components/GalleryReferences.astro";
import ItemNavigation from "../../../components/ItemNavigation.astro";
import MediaStage from "../../../components/MediaStage.astro";
import UnfurlMeta from "../../../components/UnfurlMeta.astro";
import { buildEmbedFormats, type EmbedFormatOption } from "../../../lib/embed-formats";
import {
  formatBytes,
  formatFileDate,
  sameUtcDay,
  shouldShowModified,
} from "../../../lib/public-file";
import {
  applyPublicGalleryHeaders,
  fetchPublicGallery,
  galleryItemDownloadUrl,
  galleryItemPath,
  galleryPath,
  mediaKind as kind,
  type PublicGalleryItem,
} from "../../../lib/public-gallery";
import { oembedDiscoveryHref } from "../../../lib/oembed";
import { env } from "cloudflare:workers";
import { publicApiFetch } from "../../../lib/ssr-fetch";

export const prerender = false;

const id = Astro.params.id ?? "";
const itemId = Astro.params.item ?? "";
const origin =
  env.UPLOADS_API_ORIGIN ?? import.meta.env.PUBLIC_UPLOADS_API_ORIGIN ?? "https://api.uploads.sh";
const result = await fetchPublicGallery(id, { origin, fetch: publicApiFetch(env) });

applyPublicGalleryHeaders(Astro.response.headers);

const gallery = result.status === "ok" ? result.gallery : null;
const items = gallery
  ? gallery.items.toSorted((a, b) => a.position - b.position || a.id.localeCompare(b.id))
  : [];
const index = items.findIndex((entry) => entry.id === itemId);
const item = index === -1 ? null : items[index];
if (result.status === "unavailable") Astro.response.status = 503;
else if (!item) Astro.response.status = 404;

const previous = index > 0 ? items[index - 1] : null;
const next = index >= 0 && index < items.length - 1 ? items[index + 1] : null;
const listPath = galleryPath(id);
const itemPath = (target: PublicGalleryItem) => galleryItemPath(id, target.id);
const canonical = new URL(item ? itemPath(item) : listPath, Astro.url.origin).href;
const title =
  item && gallery
    ? `${item.filename} · ${gallery.title} · uploads.sh`
    : "Media unavailable · uploads.sh";
const itemKind = item ? kind(item) : null;
const embedFormats: EmbedFormatOption[] =
  item && item.status === "available" && item.url && itemKind
    ? buildEmbedFormats({
        canonical,
        url: item.url,
        embedUrl: item.embedUrl,
        filename: item.filename,
        // item.status === "available" above means mediaKind() (itemKind) never
        // returns "missing" here — that variant only occurs for missing items.
        kind: itemKind as Exclude<typeof itemKind, "missing">,
      })
    : [];
const downloadUrl =
  item && item.status === "available" ? galleryItemDownloadUrl(origin, id, item.id) : null;
const oembedHref = gallery && item ? oembedDiscoveryHref(canonical, Astro.url.origin) : null;
const uploadedIso = item?.uploaded ?? null;
const modifiedIso = item?.modified ?? null;
const showModified = shouldShowModified(uploadedIso, modifiedIso);
const withTime = Boolean(
  showModified && uploadedIso && modifiedIso && sameUtcDay(uploadedIso, modifiedIso),
);
const uploadedLabel = uploadedIso ? formatFileDate(uploadedIso, { withTime }) : null;
const modifiedLabel =
  showModified && modifiedIso ? formatFileDate(modifiedIso, { withTime }) : null;
const description = item?.caption ?? gallery?.description ?? "Public media hosted by uploads.sh.";
const unfurlKind =
  item && item.status === "available" && (itemKind === "image" || itemKind === "video")
    ? itemKind
    : "other";
const sizeLabel =
  item && item.size != null && Number.isSafeInteger(item.size) ? formatBytes(item.size) : null;
// Rail footnote (demoted from a Size/Uploaded/Modified dl — parity with the /f/ file page):
// one muted line beneath the actions instead of a data table.
const footnoteParts = [
  sizeLabel,
  uploadedLabel ? `Uploaded ${uploadedLabel}` : null,
  modifiedLabel ? `Modified ${modifiedLabel}` : null,
].filter((part): part is string => Boolean(part));
const footnoteLine = footnoteParts.join(" · ");
---

<PublicItemLayout title={title} canonical={canonical} description={description}>
  <Fragment slot="head">
    <UnfurlMeta
      pageUrl={canonical}
      siteOrigin={Astro.url.origin}
      title={item ? item.filename : "Media unavailable"}
      description={description}
      kind={unfurlKind}
      mediaUrl={item && item.status === "available" ? item.url : null}
      contentType={item?.contentType ?? null}
      posterUrl={item?.posterUrl ?? null}
      width={item?.videoDimensions?.width ?? null}
      height={item?.videoDimensions?.height ?? null}
    />
    {
      oembedHref && item && (
        <link
          rel="alternate"
          type="application/json+oembed"
          href={oembedHref}
          title={`${item.filename} oEmbed Profile`}
        />
      )
    }
  </Fragment>
  {
    gallery && item ? (
      <>
        <div class="crumbs">
          <a href={listPath}>{gallery.title}</a> ·{" "}
          <span class="count">
            {index + 1} of {items.length}
          </span>
        </div>
        <header class="filehead">
          <h1 class="filetitle">{item.filename}</h1>
          <GalleryReferences references={gallery.references} variant="header" />
        </header>
        <MediaStage
          kind={kind(item)}
          url={item.url}
          filename={item.filename}
          alt={item.altText ?? item.caption ?? item.filename}
          posterUrl={item.posterUrl}
          videoDimensions={item.videoDimensions}
          railId="item-caption"
          contentType={item.contentType}
          size={item.size}
          downloadUrl={downloadUrl}
        >
          <ItemNavigation
            slot="navigation"
            previous={previous ? itemPath(previous) : null}
            next={next ? itemPath(next) : null}
            list={listPath}
            label="Gallery items"
            listLabel="All items"
          />
          {item.caption && <div class="caption">{item.caption}</div>}
          {item.status === "available" && (
            <CopyAsControls formats={embedFormats} downloadUrl={downloadUrl}>
              {item.url && (
                <a class="original" href={item.url} rel="noopener noreferrer">
                  Open original ↗
                </a>
              )}
            </CopyAsControls>
          )}
          {footnoteLine && <p class="footnote">{footnoteLine}</p>}
        </MediaStage>
      </>
    ) : (
      <section class="error">
        <p>
          {result.status === "unavailable"
            ? "The gallery service could not be reached. Please try again shortly."
            : "This item may have been removed, or the link is incorrect."}
        </p>
        {result.status !== "unavailable" && (
          <p>
            <a href={listPath}>View the gallery</a>
          </p>
        )}
      </section>
    )
  }
</PublicItemLayout>
<style>
  .caption {
    margin: 0;
    color: var(--body);
    font-size: var(--text-body);
    line-height: 1.6;
    white-space: pre-wrap;
  }
  .footnote {
    margin: auto 0 0;
    color: var(--muted);
    font: var(--text-micro) / 1.5 var(--sans);
  }
</style>
