---
// Every /docs subject page. One prerendered route over the `docs` content
// collection: the frontmatter supplies the DocsLayout props, and the prev/next
// chain comes from `navOrder`, so adding a page is dropping an .mdx file into
// src/content/docs — no route, nav, or pagination edit needed.
//
// The hub (/docs) stays its own .astro page and uses DocsLayout directly.
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocsPagination, getOrderedDocs } from "../../lib/docs-nav";

export async function getStaticPaths() {
  const entries = await getOrderedDocs();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const entries = await getOrderedDocs();
const { prev, next, nextIsHub } = getDocsPagination(entries, entry.id);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/docs/${entry.id}`}
  heading={entry.data.heading}
  tagline={entry.data.tagline}
  active={entry.data.navSlug}
  toc={entry.data.toc}
>
  <Content />

  <nav class="page-nav" aria-label="More docs">
    <a class="prev" href={prev.href}><span class="dir">← Back</span>{prev.label}</a>
    <a class="next" href={next.href}
      ><span class="dir">{nextIsHub ? "Docs →" : "Next →"}</span>{next.label}</a
    >
  </nav>
</DocsLayout>
