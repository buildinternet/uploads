---
import {
  applyAuthSecurityHeaders,
  devicePageCsp,
  resolveSignedInOrigins,
} from "../../lib/signed-in-page";
import BaseHead from "../../components/BaseHead.astro";
import Brand from "../../components/Brand.astro";
import Footer from "../../components/Footer.astro";
import GitHubMark from "../../components/GitHubMark.astro";
import LegalConsent from "../../components/LegalConsent.astro";

export const prerender = false;

// Session check goes to the auth origin; the ticket preview and consume go to
// the API origin (`/me/slack/connect/:ticket`). Same CSP shape as /device.
const { authOrigin, apiOrigin } = resolveSignedInOrigins();

// Header (not meta): frame-ancestors is ignored on meta CSP.
applyAuthSecurityHeaders(Astro.response.headers, devicePageCsp(authOrigin, apiOrigin));
---

<html lang="en">
  <head>
    <BaseHead />
    <title>Connect Slack · uploads.sh</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 28px;
        background: var(--bg);
        color: var(--fg);
        font: var(--text-body) / var(--leading-body) var(--sans);
        letter-spacing: var(--tracking-body);
      }
      main {
        width: min(var(--width-card, 480px), 100%);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        padding: clamp(24px, 6vw, 40px);
      }
      .brandbar {
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
      }
      h1 {
        margin: 0 0 8px;
        font-size: var(--text-h2);
        font-weight: var(--weight-semibold);
        letter-spacing: -0.015em;
        line-height: 1.25;
      }
      p {
        color: var(--body);
        margin: 0 0 20px;
      }
      strong {
        color: var(--fg);
        overflow-wrap: anywhere;
      }
      .status {
        margin: 16px 0;
      }
      .muted {
        color: var(--muted);
        font-size: var(--text-ui);
      }
      button.github {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font: var(--text-ui) var(--sans);
        letter-spacing: 0.02em;
        color: var(--fg);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        padding: 12px 16px;
        cursor: pointer;
      }
      button.github:hover,
      button.github:focus-visible {
        border-color: var(--accent);
        outline: none;
      }
      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0;
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      form {
        display: grid;
        gap: 10px;
      }
      label {
        display: grid;
        gap: 6px;
        color: var(--muted);
        font-size: var(--text-micro);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      input {
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-md);
        color: var(--fg);
        padding: 10px 12px;
        font: var(--text-ui) var(--sans);
      }
      input:focus-visible {
        border-color: var(--accent);
        outline: none;
      }
      .actions {
        display: flex;
        gap: 10px;
      }
      button.primary,
      button.secondary,
      button[type="submit"] {
        flex: 1;
        font: var(--text-micro) var(--sans);
        letter-spacing: 0.04em;
        color: var(--accent);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 11px 13px;
        cursor: pointer;
      }
      button.secondary {
        color: var(--muted);
      }
      /* The confirm step's one action: filled, and last in the row. */
      #connect-btn {
        color: var(--bg);
        background: var(--accent);
        border-color: var(--accent);
        font-weight: var(--weight-semibold);
      }
      #connect-btn:hover,
      #connect-btn:focus-visible {
        filter: brightness(1.08);
      }
      button.primary:hover,
      button.primary:focus-visible,
      button[type="submit"]:hover,
      button[type="submit"]:focus-visible {
        border-color: var(--accent);
        outline: none;
      }
      button.secondary:hover,
      button.secondary:focus-visible {
        border-color: var(--red);
        color: var(--red);
        outline: none;
      }
      button:disabled {
        opacity: 0.6;
        cursor: default;
      }
      [hidden] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="brandbar"><Brand /></div>
      <h1>Connect Slack</h1>

      <div id="checking" class="ul-callout status" role="status">Checking…</div>

      <div id="unavailable" hidden>
        <div class="ul-callout status" data-state="error" role="alert">
          uploads.sh is unreachable right now. Try again in a moment.
        </div>
        <button type="button" class="primary" id="retry-btn">Try again</button>
      </div>

      <div id="expired" hidden>
        <div class="ul-callout status" data-state="error" role="alert">
          This link expired. Open the uploads.sh app's Home tab in Slack to get a new one.
        </div>
      </div>

      <div id="signed-out" hidden>
        <p>Sign in to connect your Slack account.</p>
        <button type="button" class="github" id="github-btn">
          <GitHubMark size={16} />
          Continue with GitHub
        </button>
        <div class="divider">or</div>
        <form id="magic-form">
          <label>
            Email
            <input
              id="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
          </label>
          <button type="submit" id="magic-submit">Send sign-in link</button>
        </form>
        <div class="ul-callout status" id="signin-error" data-state="error" role="alert" hidden>
        </div>
        <LegalConsent />
      </div>

      <div id="sent-state" hidden>
        <div class="ul-callout status" data-state="ready" role="status">
          Check your email for a sign-in link. It brings you back to this page.
        </div>
      </div>

      <div id="confirm" hidden>
        <p>
          Connect Slack user <strong id="slack-user"></strong>{" "}in{" "}<strong id="team-name"
          ></strong>{" "}to{" "}<strong id="who"></strong>?
        </p>
        <p class="muted">
          Only continue if that's your own Slack account. If someone sent you this link, cancel.
        </p>
        <div class="actions">
          <button type="button" class="secondary" id="cancel-btn">Cancel</button>
          <button type="button" class="primary" id="connect-btn">Connect</button>
        </div>
        <div class="ul-callout status" id="confirm-error" data-state="error" role="alert" hidden>
        </div>
      </div>

      <div id="connected" hidden>
        <div class="ul-callout status" data-state="ready" role="status">
          Connected. Head back to Slack.
        </div>
      </div>

      <div id="cancelled" hidden>
        <div class="ul-callout status" role="status">Not connected. You can close this page.</div>
      </div>

      <Footer compact />
    </main>
    <script define:vars={{ authOrigin, apiOrigin }}>
      window.__UPLOADS_AUTH_ORIGIN__ = authOrigin;
      window.__UPLOADS_API_ORIGIN__ = apiOrigin;
    </script>
    <script>
      import { getSession, sendMagicLink, signInWithGitHub } from "../../lib/auth-client";
      import { connectSlackTicket, previewSlackTicket } from "../../lib/slack-connect";

      const authOrigin = (window as unknown as { __UPLOADS_AUTH_ORIGIN__: string })
        .__UPLOADS_AUTH_ORIGIN__;
      const apiOrigin = (window as unknown as { __UPLOADS_API_ORIGIN__: string })
        .__UPLOADS_API_ORIGIN__;

      function requireElement<T extends Element>(selector: string): T {
        const element = document.querySelector<T>(selector);
        if (!element) throw new Error(`slack connect page is missing ${selector}`);
        return element as T;
      }

      const checking = requireElement<HTMLElement>("#checking");
      const unavailable = requireElement<HTMLElement>("#unavailable");
      const expired = requireElement<HTMLElement>("#expired");
      const signedOut = requireElement<HTMLElement>("#signed-out");
      const sentState = requireElement<HTMLElement>("#sent-state");
      const confirmBox = requireElement<HTMLElement>("#confirm");
      const connected = requireElement<HTMLElement>("#connected");
      const cancelled = requireElement<HTMLElement>("#cancelled");
      const teamName = requireElement<HTMLElement>("#team-name");
      const slackUser = requireElement<HTMLElement>("#slack-user");
      const who = requireElement<HTMLElement>("#who");
      const githubBtn = requireElement<HTMLButtonElement>("#github-btn");
      const magicForm = requireElement<HTMLFormElement>("#magic-form");
      const magicSubmit = requireElement<HTMLButtonElement>("#magic-submit");
      const emailInput = requireElement<HTMLInputElement>("#email");
      const signinError = requireElement<HTMLElement>("#signin-error");
      const connectBtn = requireElement<HTMLButtonElement>("#connect-btn");
      const cancelBtn = requireElement<HTMLButtonElement>("#cancel-btn");
      const confirmError = requireElement<HTMLElement>("#confirm-error");

      const ticket = new URLSearchParams(location.search).get("ticket")?.trim() ?? "";
      const callbackURL = () => location.href;

      function show(el: HTMLElement) {
        for (const panel of [
          checking,
          unavailable,
          expired,
          signedOut,
          sentState,
          confirmBox,
          connected,
          cancelled,
        ]) {
          panel.hidden = panel !== el;
        }
      }

      async function proceed() {
        show(checking);
        if (!ticket) return show(expired);

        const session = await getSession(authOrigin);
        if (session.kind === "unavailable") return show(unavailable);
        if (session.kind !== "signed_in") return show(signedOut);

        const preview = await previewSlackTicket(apiOrigin, ticket);
        if (preview.kind === "signed_out") return show(signedOut);
        if (preview.kind === "expired") return show(expired);
        if (preview.kind === "unavailable") return show(unavailable);

        teamName.textContent = preview.ticket.teamName ?? "your Slack workspace";
        slackUser.textContent = preview.ticket.slackUserName
          ? `@${preview.ticket.slackUserName}`
          : preview.ticket.slackUserId;
        who.textContent = session.session.user.email;
        show(confirmBox);
      }

      requireElement<HTMLButtonElement>("#retry-btn").addEventListener("click", () => {
        void proceed();
      });

      githubBtn.addEventListener("click", async () => {
        signinError.hidden = true;
        githubBtn.disabled = true;
        const ok = await signInWithGitHub(authOrigin, callbackURL());
        if (!ok) {
          githubBtn.disabled = false;
          signinError.textContent = "GitHub sign-in isn't available right now.";
          signinError.hidden = false;
        }
      });

      magicForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        signinError.hidden = true;
        magicSubmit.disabled = true;
        try {
          const ok = await sendMagicLink(authOrigin, emailInput.value.trim(), callbackURL());
          if (!ok) throw new Error("send failed");
          show(sentState);
        } catch {
          signinError.textContent = "Couldn't send the sign-in link. Try again.";
          signinError.hidden = false;
        } finally {
          magicSubmit.disabled = false;
        }
      });

      connectBtn.addEventListener("click", () => {
        void (async () => {
          confirmError.hidden = true;
          connectBtn.disabled = true;
          cancelBtn.disabled = true;
          const result = await connectSlackTicket(apiOrigin, ticket);
          if (result.kind === "ok") return show(connected);
          if (result.kind === "expired") return show(expired);
          if (result.kind === "signed_out") return show(signedOut);
          connectBtn.disabled = false;
          cancelBtn.disabled = false;
          confirmError.textContent = "Couldn't connect right now. Try again.";
          confirmError.hidden = false;
        })();
      });

      cancelBtn.addEventListener("click", () => {
        show(cancelled);
      });

      void proceed();
    </script>
  </body>
</html>
