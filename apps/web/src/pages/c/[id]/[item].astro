---
import PublicItemLayout from "../../../layouts/PublicItemLayout.astro";
import CopyAsControls from "../../../components/CopyAsControls.astro";
import ItemNavigation from "../../../components/ItemNavigation.astro";
import MediaStage from "../../../components/MediaStage.astro";
import UnfurlMeta from "../../../components/UnfurlMeta.astro";
import { buildEmbedFormats, type EmbedFormatOption } from "../../../lib/embed-formats";
import {
  formatBytes,
  formatFileDate,
  sameUtcDay,
  shouldShowModified,
} from "../../../lib/public-file";
import {
  applyPublicFeedHeaders,
  fetchPublicFeed,
  fetchPublicFeedItem,
  feedItemPath,
  feedPageCopy,
  feedPath,
  mediaKind as kind,
  PUBLIC_FEED_SCAN_CAP,
  type PublicFeedItem,
} from "../../../lib/public-feed";
import { oembedDiscoveryHref } from "../../../lib/oembed";
import { env } from "cloudflare:workers";
import { publicApiFetch } from "../../../lib/ssr-fetch";

export const prerender = false;

const id = Astro.params.id ?? "";
const itemId = Astro.params.item ?? "";
const origin =
  env.UPLOADS_API_ORIGIN ?? import.meta.env.PUBLIC_UPLOADS_API_ORIGIN ?? "https://api.uploads.sh";
const [listResult, itemResult] = await Promise.all([
  fetchPublicFeed(id, { origin, fetch: publicApiFetch(env) }),
  fetchPublicFeedItem(id, itemId, { origin, fetch: publicApiFetch(env) }),
]);

applyPublicFeedHeaders(Astro.response.headers);

const pageData = itemResult.status === "ok" ? itemResult.page : null;
const feed = pageData?.feed ?? null;
const item = pageData?.item ?? null;
if (itemResult.status === "unavailable") Astro.response.status = 503;
else if (!item) Astro.response.status = 404;

// The thumbnail strip shows the newest page. An older item gets the pager
// (driven by the scope scan) without a strip.
const newestItems = listResult.status === "ok" ? listResult.feed.items : [];
const strip = item && newestItems.some((entry) => entry.id === item.id) ? newestItems : [];
const newer = pageData?.prev ?? null;
const older = pageData?.next ?? null;
// The API caps `total` at the scan cap and sends no "capped" flag, so a total
// at the cap may be exact or truncated. "or more" is true either way.
const position = pageData
  ? `${pageData.index + 1} of ${pageData.total}${pageData.total >= PUBLIC_FEED_SCAN_CAP ? " or more" : ""}`
  : "";
const listPath = feedPath(id);
const itemPath = (target: PublicFeedItem) => feedItemPath(id, target.id);
const page = feed ? feedPageCopy(feed) : null;
const canonical = new URL(item ? itemPath(item) : listPath, Astro.url.origin).href;
const title =
  item && feed ? `${item.filename} · ${feed.title} · uploads.sh` : "Media unavailable · uploads.sh";
const itemKind = item ? kind(item) : null;
const embedFormats: EmbedFormatOption[] =
  item && item.status === "available" && item.url && itemKind
    ? buildEmbedFormats({
        canonical,
        url: item.url,
        embedUrl: item.embedUrl,
        filename: item.filename,
        kind: itemKind as Exclude<typeof itemKind, "missing">,
      })
    : [];
const oembedHref = feed && item ? oembedDiscoveryHref(canonical, Astro.url.origin) : null;
const uploadedIso = item?.uploaded ?? null;
const modifiedIso = item?.modified ?? null;
const showModified = shouldShowModified(uploadedIso, modifiedIso);
const withTime = Boolean(
  showModified && uploadedIso && modifiedIso && sameUtcDay(uploadedIso, modifiedIso),
);
const uploadedLabel = uploadedIso ? formatFileDate(uploadedIso, { withTime }) : null;
const modifiedLabel =
  showModified && modifiedIso ? formatFileDate(modifiedIso, { withTime }) : null;
const description =
  item && page
    ? `${item.filename} in the ${page.scopeLabel} live link.`
    : "A public live link hosted by uploads.sh.";
const unfurlKind =
  item && item.status === "available" && (itemKind === "image" || itemKind === "video")
    ? itemKind
    : "other";
const sizeLabel =
  item && item.size != null && Number.isSafeInteger(item.size) ? formatBytes(item.size) : null;
const footnoteParts = [
  sizeLabel,
  uploadedLabel ? `Uploaded ${uploadedLabel}` : null,
  modifiedLabel ? `Modified ${modifiedLabel}` : null,
  item?.path ? item.path : null,
  item?.state ? item.state : null,
].filter((part): part is string => Boolean(part));
const footnoteLine = footnoteParts.join(" · ");

function thumbSrc(entry: PublicFeedItem): string | null {
  const media = kind(entry);
  if (media === "image") return entry.embedUrl ?? entry.url;
  if (media === "video" || entry.contentType === "application/pdf") return entry.posterUrl ?? null;
  return null;
}
---

<PublicItemLayout title={title} canonical={canonical} description={description}>
  <Fragment slot="head">
    <UnfurlMeta
      pageUrl={canonical}
      siteOrigin={Astro.url.origin}
      title={item ? item.filename : "Media unavailable"}
      description={description}
      kind={unfurlKind}
      mediaUrl={item && item.status === "available" ? item.url : null}
      contentType={item?.contentType ?? null}
      posterUrl={item?.posterUrl ?? null}
      width={item?.videoDimensions?.width ?? null}
      height={item?.videoDimensions?.height ?? null}
    />
    {
      oembedHref && item && (
        <link
          rel="alternate"
          type="application/json+oembed"
          href={oembedHref}
          title={`${item.filename} oEmbed Profile`}
        />
      )
    }
  </Fragment>
  {
    feed && item ? (
      <>
        <div class="crumbs">
          <a href={listPath}>{feed.title}</a> · <span class="count">{position}</span>
        </div>
        <header class="filehead">
          <h1 class="filetitle">{item.filename}</h1>
        </header>
        <MediaStage
          kind={kind(item)}
          url={item.url}
          filename={item.filename}
          alt={item.filename}
          posterUrl={item.posterUrl}
          videoDimensions={item.videoDimensions}
          railId="item-caption"
          contentType={item.contentType}
          size={item.size}
          downloadUrl={item.status === "available" ? item.url : null}
        >
          <ItemNavigation
            slot="navigation"
            previous={newer ? feedItemPath(id, newer) : null}
            next={older ? feedItemPath(id, older) : null}
            list={listPath}
            label="Live link items"
          />
          {item.status === "available" && (
            <CopyAsControls formats={embedFormats} downloadUrl={item.url}>
              {item.url && (
                <a class="original" href={item.url} rel="noopener noreferrer">
                  Open original ↗
                </a>
              )}
            </CopyAsControls>
          )}
          {footnoteLine && <p class="footnote">{footnoteLine}</p>}
        </MediaStage>

        {strip.length > 1 && (
          <nav class="strip" aria-label="Newest files">
            {strip.map((entry, entryIndex) => {
              const src = thumbSrc(entry);
              return (
                <a
                  href={itemPath(entry)}
                  class={entry.id === item.id ? "current" : undefined}
                  aria-current={entry.id === item.id ? "page" : undefined}
                  aria-label={`${entry.filename} (${entryIndex + 1} of ${strip.length})`}
                >
                  {src ? (
                    <img src={src} alt="" />
                  ) : (
                    <span class="placeholder">{entryIndex + 1}</span>
                  )}
                </a>
              );
            })}
          </nav>
        )}
      </>
    ) : (
      <section class="error">
        <p>
          {itemResult.status === "unavailable"
            ? "The service could not be reached. Please try again shortly."
            : "This item may have been removed, or the link is incorrect."}
        </p>
        {itemResult.status !== "unavailable" && (
          <p>
            <a href={listPath}>View the live link</a>
          </p>
        )}
      </section>
    )
  }
</PublicItemLayout>
<style>
  .strip {
    display: flex;
    gap: 8px;
    margin: 18px 0 0;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .strip a {
    flex: none;
    width: 72px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 6px);
    background: var(--panel);
    overflow: hidden;
    text-decoration: none;
  }
  .strip a.current {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .strip .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--muted);
    font: var(--text-micro) var(--mono);
  }
  .footnote {
    margin: auto 0 0;
    color: var(--muted);
    font: var(--text-micro) / 1.5 var(--sans);
  }
</style>
