---
import BaseHead from "../components/BaseHead.astro";
import Brand from "../components/Brand.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import ViewTransitions from "../components/ViewTransitions.astro";

interface Props {
  title: string;
  canonical: string;
  description: string;
}
const { title, canonical, description } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <BaseHead />
    <ViewTransitions />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body class="public-item-page">
    <main class="shell">
      <nav class="top" aria-label="Site" transition:persist="public-item-header">
        <Brand />
        <ThemeToggle />
      </nav>
      <slot />
    </main>
    <div transition:persist="public-item-footer"><Footer /></div>
  </body>
</html>
<style>
  :global(.public-item-page *) {
    box-sizing: border-box;
  }
  :global(body.public-item-page) {
    margin: 0;
    min-height: 100dvh;
    color: var(--fg);
    background: var(--bg);
    font-family: var(--sans);
    display: flex;
    flex-direction: column;
  }
  .shell {
    width: min(var(--width-viewer, 1080px), calc(100% - 48px));
    margin: 0 auto;
    padding: 36px 0 64px;
    flex: 1 0 auto;
    box-sizing: border-box;
  }
  nav.top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    font: var(--text-meta) var(--mono);
    letter-spacing: 0.02em;
  }
  /* List link on the left, ‹ n / total › pager on the right. */
  .shell :global(.crumbs) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    color: var(--muted);
    font: var(--text-meta) var(--mono);
    overflow-wrap: anywhere;
  }
  /* Title on the left, FileActions on the right; same as the public file page. */
  .shell :global(.filehead) {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px 24px;
    margin: 0 0 16px;
    min-width: 0;
  }
  .shell :global(.filehead-text) {
    flex: 1 1 320px;
    min-width: 0;
  }
  .shell :global(.filetitle) {
    margin: 0;
    color: var(--fg);
    font: 600 var(--text-h3) var(--mono);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .shell :global(.error) {
    padding: 70px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
    background: var(--panel);
    color: var(--body);
  }
  .shell :global(.error code) {
    color: var(--accent);
    font-family: var(--mono);
  }
  .shell :global(a) {
    color: var(--fg);
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 3px;
  }
  @media (min-width: 1080px) {
    /* align with signed-in --bp-rail (1080px); media queries can't read custom props */
    .shell {
      width: min(1200px, calc(100% - 48px));
    }
  }
  @media (max-width: 760px) {
    .shell {
      width: min(100% - 32px, 1080px);
      padding-top: 24px;
    }
  }
</style>
