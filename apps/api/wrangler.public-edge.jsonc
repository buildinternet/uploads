// Inert until an operator provisions the viewer and enables zone routes.
// Route api.uploads.sh/public/* here only after staging measurements pass.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uploads-public-edge",
  "main": "src/public-edge.ts",
  "compatibility_date": "2026-07-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "PUBLIC_VIEWER_ROLLOUT": "off",
  },
  "services": [
    {
      "binding": "API",
      "service": "uploads-api",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": {
      "enabled": true,
    },
  },
}
