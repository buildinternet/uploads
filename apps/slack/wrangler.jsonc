{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uploads-slack",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The only origin whose share links this app unfurls.
    "WEB_ORIGIN": "https://uploads.sh",
    // Public API origin. Requests go over the API binding when it's bound;
    // this is the host they're addressed to, and the plain-fetch target in dev.
    "API_ORIGIN": "https://api.uploads.sh",
    // This worker's public origin; the OAuth redirect URI is
    // `${SLACK_ORIGIN}/slack/oauth/callback` and must match manifest.json.
    "SLACK_ORIGIN": "https://agents.uploads.sh",
    // The Slack app's public identifiers (not secrets).
    "SLACK_APP_ID": "A0CA0AWAJCD",
    "SLACK_CLIENT_ID": "12373944164736.12340370358421",
    // "on" adds Work Object metadata to unfurls (src/entities.ts). Needs
    // features.rich_previews in the synced manifest; "off" sends blocks only.
    "SLACK_WORK_OBJECTS": "on",
  },
  // Served as a path on the agent subdomain instead of a hostname of its own.
  // agents.uploads.sh is a Custom Domain on uploads-mcp; a route on the same
  // hostname runs before the Custom Domain worker, so only /slack/* reaches
  // this worker and everything else still goes to uploads-mcp.
  "routes": [
    {
      "pattern": "agents.uploads.sh/slack/*",
      "zone_name": "uploads.sh",
    },
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": {
      "enabled": true,
    },
  },
  "upload_source_maps": true,
  // Preview data comes from uploads-api's public read endpoints
  // (/public/files|feeds|galleries) over a service binding: no edge
  // subrequest, and immune to WAF rules on the public origin (see #998).
  // Without the binding (local dev) the worker falls back to fetch().
  "services": [
    {
      "binding": "API",
      "service": "uploads-api",
    },
  ],
  // Shared with uploads-api; migrations are managed from apps/api
  // (slack_installations: 20261018160000_slack_installations.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uploads-production",
      "database_id": "5f73946b-edd5-414c-856c-8f9bd3c644ba",
    },
  ],
  // Secrets, set with `wrangler secret put <NAME> --config apps/slack/wrangler.jsonc`:
  //   SLACK_SIGNING_SECRET  verifies every inbound request (fail closed: 503 when unset)
  //   SLACK_CLIENT_SECRET   OAuth client secret for /slack/install (installs answer 503 when unset)
  //   SLACK_TOKENS_KEY      master key that seals bot tokens in D1 and signs OAuth state (16+ chars)
}
