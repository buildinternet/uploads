// Hosted read gate. Deploy does not attach routes: this file has no `routes`
// array, and wrangler only publishes routes when that list is non-empty, so a
// deploy neither adds nor deletes them. Ops adds one zone route at a time
// (store.uploads.sh/*, then storage.uploads.sh/*, then embed.uploads.sh/*).
// Not custom domains — those hosts are already R2 custom domains.
//
// Workers Builds watch paths, if the project is created: apps/read-gate/**,
// pnpm-lock.yaml, pnpm-workspace.yaml. Root `/`, no build command, deploy
// `pnpm run deploy:read-gate`, non-production branch builds off.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uploads-read-gate",
  "main": "src/index.ts",
  // Held-image card. A PNG import is the file's bytes, not a URL.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": false }],
  "compatibility_date": "2026-07-06",
  "workers_dev": false,
  "preview_urls": false,
  // Every hosted read invokes this Worker. Per-read counts live in the
  // VIEWS dataset, including D1 fail-opens (gate = fail_open), so logs keep
  // a 10% sample.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  // One point per hosted GET (src/views.ts). Blob order is VIEW_BLOB_ORDER.
  // Datasets auto-create on first write.
  "analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "uploads_file_views" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uploads-production",
      "database_id": "5f73946b-edd5-414c-856c-8f9bd3c644ba",
    },
  ],
  "previews": {
    "analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "uploads_file_views_preview" }],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "uploads-preview",
        "database_id": "b8c82095-b471-4e3a-8634-56e0861e43f1",
      },
    ],
  },
}
